{
  "name": "assert",
  "version": "1.0.0",
  "description": "断言页面状态或接口响应",
  "triggers": ["断言", "验证", "assert", "check", "verify"],
  "parameters": {
    "type": "object",
    "required": ["type", "target", "contains"],
    "additionalProperties": false,
    "properties": {
      "type": { "const": "assert" },
      "target": {
        "type": "string",
        "enum": ["page", "api"],
        "description": "page=断言页面文本；api=断言最近一次捕获的接口响应"
      },
      "contains": { "type": "string", "description": "期望包含的字符串" },
      "description": { "type": "string" },
      "id": { "type": "string", "description": "步骤 ID" },
      "output_binding": { "type": "object", "description": "输出变量绑定" }
    }
  },
  "returns": {
    "type": "object",
    "properties": {
      "expected": { "type": "string" },
      "actual": { "type": "string" },
      "pass": { "type": "boolean" }
    }
  },
  "timeout_ms": 10000,
  "retry_policy": { "max_retries": 0 }
}
