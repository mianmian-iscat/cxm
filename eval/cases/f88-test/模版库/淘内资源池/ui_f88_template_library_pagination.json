{
  "id": "ui-f88-template-library-pagination",
  "name": "UI：淘内资源池-分页功能验证",
  "description": "验证资源池分页：页码显示/翻页/每页数量/总数文案",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateLibrary",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateLibrary",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const pagination = document.querySelector('.ant-pagination'); return { hasPagination: !!pagination, text: pagination ? pagination.textContent.trim().substring(0, 50) : 'none' }; })()",
      "description": "检查分页组件",
      "storeAs": "pagination"
    },
    {
      "type": "screenshot",
      "label": "template-library-pagination",
      "description": "分页组件"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const nextBtn = document.querySelector('.ant-pagination-next:not(.ant-pagination-disabled)'); if(nextBtn) { nextBtn.click(); return 'clicked next'; } return 'no next or disabled'; })()",
      "description": "点击下一页"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "screenshot",
      "label": "template-library-page2",
      "description": "第2页"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在超过一页的模板数据。",
    "realDomNotes": "分页组件为Ant Design Pagination，含上一页/页码/下一页/总数/每页数量。",
    "riskPoints": [
      "数据不足一页时分页不显示"
    ]
  }
}