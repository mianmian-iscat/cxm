{
  "id": "atomic-f88-tl-card-fields",
  "name": "UI：淘内资源池-模板卡片字段完整性验证",
  "description": "验证模板卡片展示: 图片/标签/推荐曝光数/所属店铺",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateLibrary",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateLibrary",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开淘内资源池"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const cards = Array.from(document.querySelectorAll('[class*=card],[class*=template],[class*=item]')).slice(0,3).map(c => c.textContent.trim().substring(0,150)); return { cards, count: cards.length }; })()",
      "description": "提取模板卡片",
      "storeAs": "cards"
    },
    {
      "type": "assertStore",
      "key": "cards",
      "path": "count",
      "notEmpty": true,
      "description": "验证模板卡片非空"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const fields = ['推荐曝光数','标签']; const found = fields.filter(f => t.includes(f)); return { fields, found }; })()",
      "description": "验证字段",
      "storeAs": "fieldCheck"
    },
    {
      "type": "screenshot",
      "label": "tl-card-fields",
      "description": "模板卡片字段"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在模板资源数据",
    "realDomNotes": "展示: 大图预览/标签信息/推荐曝光数/所属店铺",
    "riskPoints": []
  }
}