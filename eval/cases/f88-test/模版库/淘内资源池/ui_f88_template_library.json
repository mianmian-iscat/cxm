    { "type": "screenshot", "label": "template-library", "description": "截图-淘内资源池页" }
  ],
  "screenshot": { "onError": true },
  "contextOptimization": { "screenshotExternal": true, "maxResponseSizeKb": 100, "outputCompact": true },
  "_expected": { "status": "pass" },
  "_testDesign": {
    "preconditions": "F88预发已登录（buc）。",
    "realDomNotes": "真实路由 /templateLibrary；模版资源池；标签筛选（设计-主品描述/搭配-配饰穿搭/拍摄-模特维度/场景维度/光影维度/构图维度/整体视觉）；筛选：Seller ID/店铺名称/Item ID/图片ID；商品表现：推荐曝光数等。",
    "riskPoints": ["标签维度可能随配置调整"]
  }
