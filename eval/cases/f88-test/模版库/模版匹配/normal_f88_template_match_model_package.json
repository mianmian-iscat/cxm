{
  "id": "normal-f88-template-match-model-package",
  "name": "正常流程：模板匹配 - 模型匹配 x 模板包",
  "description": "验证模型匹配x模板包模式下 seller_id 为强制字段，取数逻辑为模板包中全部使用中状态的搭配x主图素材",
  "businessType": "f88_material",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 50,
    "outputCompact": true
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略详情页"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待渲染"
    },
    {
      "type": "clickText",
      "text": "模板匹配",
      "description": "点击模板匹配节点"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待配置面板"
    },
    {
      "type": "selectOption",
      "label": "匹配模式",
      "option": "模型匹配",
      "description": "选择模型匹配"
    },
    {
      "type": "selectOption",
      "label": "数据来源",
      "option": "模板包",
      "description": "选择模板包"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待字段更新"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "seller_id",
      "description": "验证seller_id字段存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "使用中",
      "description": "验证仅取使用中状态的模板包数据"
    },
    {
      "type": "screenshot",
      "label": "model-match-package",
      "description": "截图 - 模型匹配x模板包"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发环境可访问，测试账号已登录，存在使用中状态的模板包",
    "riskPoints": [
      "模型匹配x模板包：seller_id为强制",
      "取数逻辑：模板包中搭配x主图素材全部使用中状态"
