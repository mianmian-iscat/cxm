{
  "id": "normal-f88-template-match-visual-library",
  "name": "正常流程：模板匹配 - 视觉模板匹配 x 模板库",
  "description": "验证视觉模板匹配在模板库模式下，选择已洗图且构图标准最优的图打上择优标识，区别于搭配模板匹配逻辑",
  "businessType": "f88_material",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 50,
    "outputCompact": true
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略详情页"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待策略渲染"
    },
    {
      "type": "clickText",
      "text": "模板匹配",
      "description": "点击模板匹配节点"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待配置面板加载"
    },
    {
      "type": "selectOption",
      "label": "应用环节",
      "option": "视觉",
      "description": "选择应用环节为「视觉」"
    },
    {
      "type": "selectOption",
      "label": "数据来源",
      "option": "模板库",
      "description": "选择数据来源为模板库"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待配置更新"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "已洗图",
      "description": "验证视觉模板匹配要求已洗图标识"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "视觉引擎",
      "description": "验证应用环节为视觉时使用视觉引擎"
    },
    {
      "type": "screenshot",
      "label": "visual-match-library",
      "description": "截图 - 视觉模板匹配x模板库"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发环境可访问，测试账号已登录，模板库中存在已洗图的视觉模板数据",
    "riskPoints": [
      "视觉模板匹配要求已洗图且构图最优，搭配模板不要求已洗图",
      "视觉引擎与搭配引擎选择逻辑不同"
    ],
    "relatedDocs": [
      "F88主图素材供给产品方案 v3.0 20260623"
    ]
  },
  "source": "dingtalk-doc-MNDoBb60VLYDGNPytBE4qmgwJlemrZQ3",
  "sourceIds": null
}