{
  "id": "normal-f88-template-match-model-library",
  "name": "正常流程：模板匹配节点 - 模型匹配 x 模板库",
  "description": "验证模板匹配节点在「模型匹配 x 模板库」模式下，能正确根据 seller_id（可选）、应用环节、应用场景匹配到模板图组，并输出 matchedImg 系列变量",
  "businessType": "f88_material",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 50,
    "outputCompact": true
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略详情页"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待策略详情页渲染"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "模板匹配",
      "description": "验证策略详情中存在模板匹配节点"
    },
    {
      "type": "clickText",
      "text": "模板匹配",
      "description": "点击模板匹配节点进入配置"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待模板匹配配置面板加载"
    },
    {
      "type": "screenshot",
      "label": "template-match-config",
      "description": "截图 - 模板匹配节点配置面板"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "匹配模式",
      "description": "验证匹配模式选项存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "模型匹配",
      "description": "验证模型匹配模式可选"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "模板库",
      "description": "验证数据来源可选模板库"
    },
    {
      "type": "selectOption",
      "label": "应用环节",
      "option": "搭配",
      "description": "选择应用环节为「搭配」"
    },
    {
      "type": "selectOption",
      "label": "应用场景",
      "option": "主图素材",
      "description": "选择应用场景为「主图素材」"
    },
    {
      "type": "screenshot",
      "label": "model-match-library-config",
      "description": "截图 - 模型匹配x模板库配置完成"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "seller_id",
      "description": "验证硬匹配字段 seller_id 存在（可选）"
    }
  ],
  "capture": {
    "enabled": true,
    "filter": "bzb.api.fsyx_quality_guard",
    "captureBody": true
  },
  "screenshot": {
    "onError": true
  },
  "post_asserts": null,
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发环境可访问，测试账号已登录，存在已配置搭配模板的模板库数据",
    "riskPoints": [
      "模型匹配x模板库的取数逻辑：【搭配 x 主图素材】对应模板库【主图搭配】应用场景",
      "搭配引擎与视觉引擎的选择逻辑",
      "seller_id为可选字段，不填时应匹配全量"
    ],
    "relatedDocs": [
      "F88主图素材供给产品方案 v3.0 20260623"
    ]
  },
  "source": "dingtalk-doc-MNDoBb60VLYDGNPytBE4qmgwJlemrZQ3",
  "sourceIds": null
}