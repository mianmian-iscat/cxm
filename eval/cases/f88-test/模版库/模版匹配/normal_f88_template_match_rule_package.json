{
  "id": "normal-f88-template-match-rule-package",
  "name": "正常流程：模板匹配节点 - 规则匹配 x 模板包",
  "description": "验证模板匹配节点在「规则匹配 x 模板包」模式下，seller_id 为强制字段，支持类目粗分类和季节可选匹配，输出正确的模板图组",
  "businessType": "f88_material",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 50,
    "outputCompact": true
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略详情页"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待策略详情页渲染"
    },
    {
      "type": "clickText",
      "text": "模板匹配",
      "description": "点击模板匹配节点进入配置"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待模板匹配配置面板加载"
    },
    {
      "type": "selectOption",
      "label": "匹配模式",
      "option": "规则匹配",
      "description": "选择匹配模式为「规则匹配」"
    },
    {
      "type": "selectOption",
      "label": "数据来源",
      "option": "模板包",
      "description": "选择数据来源为「模板包」"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待配置字段更新"
    },
    {
      "type": "screenshot",
      "label": "rule-match-package-config",
      "description": "截图 - 规则匹配x模板包配置面板"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "seller_id",
      "description": "验证 seller_id 字段存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "必填",
      "description": "验证模板包模式下 seller_id 为强制必填"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "类目粗分类",
      "description": "验证类目粗分类可选字段存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "季节",
      "description": "验证季节可选字段存在"
    },
    {
      "type": "screenshot",
      "label": "rule-match-package-fields",
      "description": "截图 - 规则匹配x模板包字段验证"
    }
  ],
  "capture": {
    "enabled": true,
    "filter": "bzb.api.fsyx_quality_guard",
    "captureBody": true
  },
  "screenshot": {
    "onError": true
  },
  "post_asserts": null,
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发环境可访问，测试账号已登录，存在已创建的模板包且状态为使用中",
    "riskPoints": [
      "模板包模式下 seller_id 为强制字段，缺失应报错",
      "规则匹配取数逻辑：【搭配 x 主图素材】对应模板包【搭配 x 主图素材】全部使用中状态",
      "类目粗分类和季节为可选，不选时应使用默认逻辑"
    ],
    "relatedDocs": [
      "F88主图素材供给产品方案 v3.0 20260623"
    ]
  },
