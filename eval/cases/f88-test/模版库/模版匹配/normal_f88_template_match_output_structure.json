{
  "id": "normal-f88-template-match-output-structure",
  "name": "正常流程：模板匹配输出变量结构验证",
  "description": "验证模板匹配节点输出 matchedImg 系列变量结构完整，包含 matchedImg1、matchedImg1_nice、matchedImg1_1~5 等全部字段",
  "businessType": "f88_material",
  "scene": "f88-test",
  "priority": "P1",
  "category": "api_contract",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 50,
    "outputCompact": true
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略详情页"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待策略详情页渲染"
    },
    {
      "type": "clickText",
      "text": "模板匹配",
      "description": "点击模板匹配节点"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待配置面板加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "matchedImg1",
      "description": "验证输出变量 matchedImg1 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "matchedImg1_nice",
      "description": "验证输出变量 matchedImg1_nice（择优标识）存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "matchedImg2",
      "description": "验证输出变量 matchedImg2 存在（目标匹配数量为2时）"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "matchedImg2_nice",
      "description": "验证输出变量 matchedImg2_nice 存在"
    },
    {
      "type": "screenshot",
      "label": "match-output-variables",
      "description": "截图 - 模板匹配输出变量结构"
    }
  ],
  "capture": {
    "enabled": true,
    "filter": "bzb.api.fsyx_quality_guard",
    "captureBody": true
  },
  "screenshot": {
    "onError": true
  },
  "post_asserts": null,
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发环境可访问，测试账号已登录，策略中已配置模板匹配节点",
    "riskPoints": [
      "目标匹配数量设置为N时，输出 matchedImg1~N 及对应 _nice 和 _1~5",
      "搭配模板匹配在模板组中选择构图标准最优的一张图打上择优标识",
      "视觉模板匹配在模板组中选择已洗图且构图标准最优的一张图打上择优标识"
    ],
    "contractFields": [
      "matchedImg1",
      "matchedImg1_nice",
      "matchedImg1_1",
      "matchedImg1_2",
      "matchedImg1_3",
      "matchedImg1_4",
      "matchedImg1_5",
      "matchedImg2",
      "matchedImg2_nice",
      "matchedImg2_1",
      "matchedImg2_2",
      "matchedImg2_3",
      "matchedImg2_4",
      "matchedImg2_5"
    ],
    "relatedDocs": [
      "F88主图素材供给产品方案 v3.0 20260623"
    ]
  },
  "source": "dingtalk-doc-MNDoBb60VLYDGNPytBE4qmgwJlemrZQ3",
  "sourceIds": null
}