{
  "id": "boundary-f88-template-match-seller-required",
  "name": "边界条件：模板包匹配时 seller_id 缺失校验",
  "description": "验证模板匹配节点选择模板包作为数据来源时，不填写 seller_id 应提示必填错误，阻断生产",
  "businessType": "f88_material",
  "scene": "f88-test",
  "priority": "P1",
  "category": "boundary",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略详情页"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待策略详情页渲染"
    },
    {
      "type": "clickText",
      "text": "模板匹配",
      "description": "点击模板匹配节点进入配置"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待配置面板加载"
    },
    {
      "type": "selectOption",
      "label": "匹配模式",
      "option": "模型匹配",
      "description": "选择匹配模式为「模型匹配」"
    },
    {
      "type": "selectOption",
      "label": "数据来源",
      "option": "模板包",
      "description": "选择数据来源为「模板包」"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待字段更新"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "seller_id",
      "description": "验证 seller_id 字段存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "必填",
      "description": "验证 seller_id 标记为必填"
    },
    {
      "type": "screenshot",
      "label": "seller-id-required",
      "description": "截图 - seller_id必填标识"
    }
  ],
  "screenshot": { "onError": true },
  "contextOptimization": { "screenshotExternal": true, "maxResponseSizeKb": 50, "outputCompact": true },
  "_expected": { "status": "pass" },
  "_testDesign": {
    "preconditions": "F88预发环境可访问，测试账号已登录",
    "riskPoints": [
      "模型匹配x模板包：seller_id为强制，不填应阻断",
      "模型匹配x模板库：seller_id为可选，不填应正常匹配全量",
      "规则匹配x模板包：seller_id为强制",
      "规则匹配x模板库：seller_id为可选"
    ],
    "boundaryType": "empty_data",
    "relatedDocs": ["F88主图素材供给产品方案 v3.0 20260623"]
  },
