{
  "id": "atomic-f88-qt-create-task-btn",
  "name": "UI：优质模板库-创建任务按钮验证",
  "description": "验证优质模板库存在创建任务按钮",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开优质模板库"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const createBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('创建任务')); return { found: !!createBtn, text: createBtn?.textContent?.trim() }; })()",
      "description": "验证创建任务按钮",
      "storeAs": "createInfo"
    },
    {
      "type": "assertStore",
      "key": "createInfo",
      "path": "found",
      "equals": true,
      "description": "验证 验证创建任务按钮 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "createInfo",
      "path": "found",
      "equals": true,
      "description": "验证创建任务按钮存在"
    },
    {
      "type": "clickText",
      "text": "新增",
      "description": "点击新增按钮"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待操作响应"
    },
    {
      "type": "screenshot",
      "label": "after-click-action",
      "description": "点击新增后截图"
    },
    {
      "type": "screenshot",
      "label": "qt-create-task",
      "description": "创建任务按钮"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在相关数据",
    "realDomNotes": "",
    "riskPoints": []
  }
}