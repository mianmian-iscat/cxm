{
  "id": "atomic-f88-qt-task-progress-btn",
  "name": "UI：优质模板库-查看任务进度按钮验证",
  "description": "验证优质模板库存在查看任务进度按钮",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开优质模板库"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const progressBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('查看任务进度')); return { found: !!progressBtn, text: progressBtn?.textContent?.trim() }; })()",
      "description": "验证查看任务进度按钮",
      "storeAs": "progressInfo"
    },
    {
      "type": "assertStore",
      "key": "progressInfo",
      "path": "found",
      "equals": true,
      "description": "验证 验证查看任务进度按钮 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "progressInfo",
      "path": "found",
      "equals": true,
      "description": "验证查看任务进度按钮存在"
    },
    {
      "type": "screenshot",
      "label": "qt-task-progress",
      "description": "查看任务进度按钮"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在相关数据",
    "realDomNotes": "",
    "riskPoints": []
  }
