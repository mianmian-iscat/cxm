{
  "id": "atomic-f88-qt-batch-entry",
  "name": "UI：优质模板库-批量操作入口验证",
  "description": "点击批量操作按钮，验证操作选项",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开优质模板库"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "批量操作",
      "description": "点击批量操作"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const ops = ['批量洗图','批量导出','批量标签修改']; const found = ops.filter(o => t.includes(o)); return { ops, found }; })()",
      "description": "验证批量操作选项",
      "storeAs": "batchOps"
    },
    {
      "type": "screenshot",
      "label": "qt-batch-entry",
      "description": "批量操作选项"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在优质模板数据",
    "realDomNotes": "批量操作: 批量洗图/批量导出/批量标签修改",
    "riskPoints": []
  }
}