{
  "id": "ui-f88-quality-template-app-scene",
  "name": "UI：优质模板库-应用场景筛选验证",
  "description": "验证优质模板库应用场景筛选：选择不同场景→列表更新→数据一致性",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const selects = Array.from(document.querySelectorAll('.ant-select')).filter(s => { const prev = s.previousElementSibling || s.parentElement?.querySelector('label, span'); return prev && prev.textContent && (prev.textContent.includes('应用') || prev.textContent.includes('场景')); }); return { count: selects.length, texts: selects.map(s => s.querySelector('.ant-select-selector')?.textContent?.trim()) }; })()",
      "description": "查找应用场景Select",
      "storeAs": "appSceneSelect"
    },
    {
      "type": "assertStore",
      "key": "appSceneSelect",
      "path": "found",
      "equals": true,
      "description": "验证 查找应用场景Select 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "验证页面已加载"
    },
    {
      "type": "screenshot",
      "label": "quality-template-app-scene",
      "description": "应用场景筛选"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录。",
    "realDomNotes": "应用场景筛选为Select，选项可能含：主图素材/种草素材/详情页。",
    "riskPoints": [
      "应用场景选项需实际确认"
    ]
  }
}