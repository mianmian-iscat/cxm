{
  "id": "atomic-f88-qt-page-load",
  "name": "UI：优质模板库-页面加载与文案完整性",
  "description": "验证页面标题、筛选区、标签维度、批量操作/创建任务/查看进度按钮",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开优质模板库"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "优质模板库",
      "description": "验证页面标题"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "批量操作",
      "description": "验证批量操作按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "创建任务",
      "description": "验证创建任务按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "查看任务进度",
      "description": "验证查看任务进度按钮"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const dims = ['设计','搭配','拍摄','场景','光影','构图','视觉']; const found = dims.filter(d => t.includes(d)); return { dims, found, coverage: found.length+'/'+dims.length }; })()",
      "description": "验证标签维度",
      "storeAs": "tagDims"
    },
    {
      "type": "screenshot",
      "label": "qt-page-load",
      "description": "优质模板库页面"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在优质模板数据",
    "realDomNotes": "标签同淘内资源池7维度 + 洗图状态 + 应用场景",
    "riskPoints": []
  }
}