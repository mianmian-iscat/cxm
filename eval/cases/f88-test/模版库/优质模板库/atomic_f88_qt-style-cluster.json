{
  "id": "atomic-f88-qt-style-cluster",
  "name": "UI：优质模板库-风格簇模式验证",
  "description": "验证优质模板库支持三种视图模式：组图/单图/风格簇",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开优质模板库"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; return { hasGroup: t.includes('组图模式'), hasSingle: t.includes('单图模式'), hasCluster: t.includes('风格簇模式') }; })()",
      "description": "验证三种视图模式",
      "storeAs": "modeInfo"
    },
    {
      "type": "assertStore",
      "key": "modeInfo",
      "path": "hasGroup",
      "equals": true,
      "description": "验证组图模式存在"
    },
    {
      "type": "assertStore",
      "key": "modeInfo",
      "path": "hasSingle",
      "equals": true,
      "description": "验证单图模式存在"
    },
    {
      "type": "assertStore",
      "key": "modeInfo",
      "path": "hasCluster",
      "equals": true,
      "description": "验证风格簇模式存在"
    },
    {
      "type": "screenshot",
      "label": "qt-view-modes",
      "description": "三种视图模式"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在相关数据",
    "realDomNotes": "三种模式：组图模式/单图模式/风格簇模式",
    "riskPoints": []
  }
}