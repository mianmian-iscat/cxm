{
  "id": "atomic-f88-qt-card-fields",
  "name": "UI：优质模板库-模板卡片字段完整性验证",
  "description": "验证模板卡片展示所有必要字段",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开优质模板库"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const cards = Array.from(document.querySelectorAll('[class*=card],[class*=template],[class*=item]')).slice(0,3).map(c => c.textContent.trim().substring(0,150)); return { cards, count: cards.length }; })()",
      "description": "提取模板卡片",
      "storeAs": "cards"
    },
    {
      "type": "assertStore",
      "key": "cards",
      "path": "found",
      "equals": true,
      "description": "验证 提取模板卡片 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "cards",
      "path": "count",
      "notEmpty": true,
      "description": "验证模板卡片非空"
    },
    {
      "type": "screenshot",
      "label": "qt-card-fields",
      "description": "模板卡片字段"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在优质模板数据",
    "realDomNotes": "",
    "riskPoints": []
  }
}