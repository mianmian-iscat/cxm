{
  "id": "atomic-f88-qt-filter-scene",
  "name": "UI：优质模板库-应用场景筛选验证",
  "description": "选择应用场景进行筛选",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/selfTemplateLibrary_f88",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开优质模板库"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const t = document.body.innerText; const hasScene = t.includes('应用场景'); return { hasScene }; })()",
      "description": "验证应用场景筛选项",
      "storeAs": "sceneFilter"
    },
    {
      "type": "assertStore",
      "key": "sceneFilter",
      "path": "found",
      "equals": true,
      "description": "验证 验证应用场景筛选项 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "验证页面已加载"
    },
    {
      "type": "screenshot",
      "label": "qt-filter-scene",
      "description": "应用场景筛选"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在优质模板数据",
    "realDomNotes": "",
    "riskPoints": []
  }
}