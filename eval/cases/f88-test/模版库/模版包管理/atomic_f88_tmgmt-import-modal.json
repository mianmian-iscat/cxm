{
  "id": "atomic-f88-tmgmt-import-modal",
  "name": "UI：模版包管理-导入模板包弹窗验证",
  "description": "点击导入模板包按钮，验证弹窗及文件上传控件",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开模版包管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "导入模板包",
      "description": "点击导入模板包"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const m = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); return { hasModal: !!m, title: m ? m.querySelector('.ant-modal-title')?.textContent?.trim() : null }; })()",
      "description": "验证弹窗",
      "storeAs": "importModal"
    },
    {
      "type": "assertStore",
      "key": "importModal",
      "path": "hasModal",
      "equals": true,
      "description": "验证导入弹窗出现"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const m = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); const fileInput = m ? m.querySelector('input[type=file]') : null; return { hasFileInput: !!fileInput, accept: fileInput ? fileInput.accept : null }; })()",
      "description": "验证文件上传",
      "storeAs": "fileUpload"
    },
    {
      "type": "screenshot",
      "label": "tmgmt-import-modal",
      "description": "导入模板包弹窗"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const c = document.querySelector('.ant-modal-close'); if(c) c.click(); return 'closed'; })()",
      "description": "关闭弹窗"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待加载"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在模版包数据",
    "realDomNotes": "导入弹窗: 上传文件(.xlsx/.zip)/店铺关联",
    "riskPoints": []
  }
}