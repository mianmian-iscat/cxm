{
  "id": "ui-f88-template-mgmt-create-import",
  "name": "UI：模版包管理-新建模板包/导入模板包弹窗验证",
  "description": "验证新建模板包弹窗(店铺选择/名称/应用环节/场景/上传)和导入模板包弹窗(文件上传/店铺关联)",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开模版包管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "新建模板包",
      "description": "点击新建模板包"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const modal = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); return { hasModal: !!modal, title: modal ? modal.querySelector('.ant-modal-title')?.textContent?.trim() : null }; })()",
      "description": "验证新建弹窗",
      "storeAs": "createModal"
    },
    {
      "type": "assertStore",
      "key": "createModal",
      "path": "hasModal",
      "equals": true,
      "description": "断言新建弹窗出现"
    },
    {
      "type": "screenshot",
      "label": "template-mgmt-create-modal",
      "description": "新建模板包弹窗"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const modal = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); if(!modal) return {}; const labels = Array.from(modal.querySelectorAll('label, .ant-form-item-label')).map(l => l.textContent.trim()); const selects = Array.from(modal.querySelectorAll('.ant-select')).length; const uploads = modal.querySelectorAll('input[type=file]').length; return { labels, selectCount: selects, uploadCount: uploads }; })()",
      "description": "验证新建弹窗字段",
      "storeAs": "createForm"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const closeBtn = document.querySelector('.ant-modal-close'); if(closeBtn) closeBtn.click(); return 'closed'; })()",
      "description": "关闭"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "导入模板包",
      "description": "点击导入模板包"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const modal = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); return { hasModal: !!modal, title: modal ? modal.querySelector('.ant-modal-title')?.textContent?.trim() : null }; })()",
      "description": "验证导入弹窗",
      "storeAs": "importModal"
    },
    {
      "type": "assertStore",
      "key": "importModal",
      "path": "hasModal",
      "equals": true,
      "description": "断言导入弹窗出现"
    },
    {
      "type": "screenshot",
      "label": "template-mgmt-import-modal",
      "description": "导入模板包弹窗"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const closeBtn = document.querySelector('.ant-modal-close'); if(closeBtn) closeBtn.click(); return 'closed'; })()",
      "description": "关闭"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录。",
    "realDomNotes": "新建弹窗：店铺选择(Select)/模板包名称(Input)/应用环节(Select:搭配/视觉/套图/视频)/应用场景(Select:主图素材/种草素材/详情页)/模板上传。导入弹窗：上传文件(input[type=file], .xlsx/.zip)/店铺关联(Select)。",
    "riskPoints": [
      "上传文件需真实文件"
    ]
  }
}