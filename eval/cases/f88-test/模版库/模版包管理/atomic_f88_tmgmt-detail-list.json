{
  "id": "atomic-f88-tmgmt-detail-list",
  "name": "UI：模版包管理-详情页模板列表验证",
  "description": "点击查看详情，验证模板列表展示",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开模版包管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "查看详情",
      "description": "点击查看详情"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { return { url: location.href, hasTable: !!document.querySelector('table,.ant-table') }; })()",
      "description": "验证详情页",
      "storeAs": "detailInfo"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const headers = Array.from(document.querySelectorAll('th')).map(th => th.textContent.trim()); return { headers, count: headers.length }; })()",
      "description": "获取模板列表列名",
      "storeAs": "detailHeaders"
    },
    {
      "type": "screenshot",
      "label": "tmgmt-detail-list",
      "description": "详情页模板列表"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在模版包数据",
    "realDomNotes": "详情页列: 模板名称/模板预览/状态/创建时间/操作",
    "riskPoints": []
  }
}