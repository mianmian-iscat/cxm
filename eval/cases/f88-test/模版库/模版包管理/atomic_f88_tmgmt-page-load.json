{
  "id": "atomic-f88-tmgmt-page-load",
  "name": "UI：模版包管理-页面加载与文案完整性",
  "description": "验证页面标题、店铺卡片列表、筛选区、按钮",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开模版包管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "模版包管理",
      "description": "验证页面标题"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "重置",
      "description": "验证重置按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "新建模板包",
      "description": "验证新建按钮"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const cards = Array.from(document.querySelectorAll('[class*=card],[class*=shop]')).slice(0,5).map(c => c.textContent.trim().substring(0,100)); return { cards, count: cards.length }; })()",
      "description": "提取店铺卡片",
      "storeAs": "shopCards"
    },
    {
      "type": "assertStore",
      "key": "shopCards",
      "path": "count",
      "notEmpty": true,
      "description": "验证店铺卡片非空"
    },
    {
      "type": "screenshot",
      "label": "tmgmt-page-load",
      "description": "模版包管理页面"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在模版包数据",
    "realDomNotes": "店铺卡片列表布局(非ant-table)，每卡片: 店铺名称/店铺ID/买手/模板包数量/使用状态",
    "riskPoints": []
  }
}