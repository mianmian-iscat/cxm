{
  "id": "atom-f88-tpm-status-in-use",
  "name": "原子：模版包管理-使用状态'使用中'标签文案验证",
  "description": "验证店铺卡片显示'使用中'状态标签",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const text = document.body.innerText; return { hasInUse: text.includes('使用中') }; })()",
      "description": "验证使用中状态",
      "storeAs": "tpmInUse"
    },
    {
      "type": "assertStore",
      "key": "tpmInUse",
      "path": "found",
      "equals": true,
      "description": "验证 验证使用中状态 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "模版",
      "description": "验证页面已加载"
    },
    {
      "type": "screenshot",
      "label": "tpm-status-in-use",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "",
    "realDomNotes": "",
    "riskPoints": [
      "无数据时为空"
    ]
  }
}