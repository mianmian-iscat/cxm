{
  "id": "atomic-f88-tmgmt-toggle",
  "name": "UI：模版包管理-激活停用入口验证",
  "description": "验证卡片操作区域激活/停用按钮存在",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开模版包管理"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const btns = Array.from(document.querySelectorAll('a,button')).filter(el => { const t = el.textContent.trim(); return t === '激活' || t === '停用'; }); return { count: btns.length, texts: btns.map(b => b.textContent.trim()) }; })()",
      "description": "查找激活/停用按钮",
      "storeAs": "toggleBtns"
    },
    {
      "type": "assertStore",
      "key": "toggleBtns",
      "path": "found",
      "equals": true,
      "description": "验证 查找激活/停用按钮 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "模版",
      "description": "验证页面已加载"
    },
    {
      "type": "screenshot",
      "label": "tmgmt-toggle",
      "description": "激活停用按钮"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在模版包数据",
    "realDomNotes": "激活需检查同seller+range+scene仅一个IN_USE(风险点#15)",
    "riskPoints": []
  }
}