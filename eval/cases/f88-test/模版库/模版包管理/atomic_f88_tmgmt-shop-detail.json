{
  "id": "atomic-f88-tmgmt-shop-detail",
  "name": "UI：模版包管理-店铺模版包列表验证",
  "description": "验证点击店铺查看详情后进入模版包列表页：面包屑/搜索/筛选/导入+新建按钮/卡片列表",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/templateManagement",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开模版包管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const detailBtns = Array.from(document.querySelectorAll('button')).filter(b => b.textContent.trim() === '查看详情'); if(detailBtns.length > 2) { detailBtns[2].click(); return 'clicked'; } return 'no btn'; })()",
      "description": "点击查看详情"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const hasBreadcrumb = t.includes('店铺管理') && t.includes('模版包列表'); const hasImport = t.includes('导入模板包'); const hasCreate = t.includes('新建模版包'); const hasSearch = document.querySelector('input[placeholder*=名称]'); return { hasBreadcrumb, hasImport, hasCreate, hasSearch: !!hasSearch }; })()",
      "description": "验证模版包列表",
      "storeAs": "listInfo"
    },
    {
      "type": "assertStore",
      "key": "listInfo",
      "path": "hasBreadcrumb",
      "equals": true,
      "description": "验证面包屑导航存在"
    },
    {
      "type": "assertStore",
      "key": "listInfo",
      "path": "hasImport",
      "equals": true,
      "description": "验证导入按钮存在"
    },
    {
      "type": "assertStore",
      "key": "listInfo",
      "path": "hasCreate",
      "equals": true,
      "description": "验证新建按钮存在"
    },
    {
      "type": "screenshot",
      "label": "tmgmt-shop-detail",
      "description": "店铺模版包列表"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在相关数据",
    "realDomNotes": "面包屑：店铺管理>模版包列表，有导入模板包/新建模版包按钮",
    "riskPoints": []
  }
}