{
  "id": "atomic-f88-pd-pagination",
  "name": "UI：生产看板-分页验证",
  "description": "验证生产看板底部有分页组件，多条链路时分页显示",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开生产看板"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const pagination = document.querySelector('.ant-pagination'); const items = pagination ? Array.from(pagination.querySelectorAll('.ant-pagination-item')).map(i => i.textContent.trim()) : []; return { hasPagination: !!pagination, pages: items }; })()",
      "description": "验证分页",
      "storeAs": "pageInfo"
    },
    {
      "type": "assertStore",
      "key": "pageInfo",
      "path": "found",
      "equals": true,
      "description": "验证 验证分页 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "生产",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "pageInfo",
      "path": "hasPagination",
      "equals": true,
      "description": "验证分页组件存在"
    },
    {
      "type": "screenshot",
      "label": "pd-pagination",
      "description": "生产看板分页"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在相关数据",
    "realDomNotes": "生产看板多条链路时分页显示",
    "riskPoints": []
  }
}