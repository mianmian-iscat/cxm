{
  "id": "atom-f88-pd-producing",
  "name": "原子：生产看板-生产中指标文案验证",
  "description": "验证看板显示'生产中'指标卡片",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "生产中",
      "description": "断言生产中指标存在"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const cards = Array.from(document.querySelectorAll('.ant-statistic, .ant-card, [class*=statistic], [class*=metric], [class*=card]')); return { cardCount: cards.length, values: cards.slice(0, 8).map(c => (c.textContent || '').trim().substring(0, 50)) }; })()",
      "description": "检查指标卡数值",
      "storeAs": "metricValues"
    },
    {
      "type": "screenshot",
      "label": "pd-producing",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "",
    "realDomNotes": "",
    "riskPoints": [
      "无数据时为空"
    ]
  }
}