{
  "id": "atomic-f88-pd-task-expand",
  "name": "UI：生产看板-任务展开功能验证",
  "description": "验证看板中任务可展开查看详情",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开生产看板"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const expandIcons = document.querySelectorAll('.ant-table-row-expand-icon,[class*=expand]'); return { count: expandIcons.length }; })()",
      "description": "查找展开控件",
      "storeAs": "expandControls"
    },
    {
      "type": "assertStore",
      "key": "expandControls",
      "path": "found",
      "equals": true,
      "description": "验证 查找展开控件 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "生产",
      "description": "验证页面已加载"
    },
    {
      "type": "screenshot",
      "label": "pd-task-expand",
      "description": "任务展开控件"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在生产数据",
    "realDomNotes": "",
    "riskPoints": []
  }
}