{
  "id": "atomic-f88-pd-link-progress",
  "name": "UI：生产看板-链路生产进度表格验证",
  "description": "验证链路生产进度表格展示",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开生产看板"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const tables = document.querySelectorAll('table,.ant-table'); const rows = Array.from(document.querySelectorAll('tbody tr')).slice(0,5).map(tr => ({ text: tr.textContent.trim().substring(0,100) })); return { tableCount: tables.length, sampleRows: rows }; })()",
      "description": "验证进度表格",
      "storeAs": "progressTable"
    },
    {
      "type": "assertStore",
      "key": "progressTable",
      "path": "found",
      "equals": true,
      "description": "验证 验证进度表格 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "生产",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "progressTable",
      "path": "tableCount",
      "notEmpty": true,
      "description": "验证进度表格存在"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const cards = Array.from(document.querySelectorAll('.ant-statistic, .ant-card, [class*=statistic], [class*=metric], [class*=card]')); return { cardCount: cards.length, values: cards.slice(0, 8).map(c => (c.textContent || '').trim().substring(0, 50)) }; })()",
      "description": "检查指标卡数值",
      "storeAs": "metricValues"
    },
    {
      "type": "screenshot",
      "label": "pd-link-progress",
      "description": "链路生产进度"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在生产数据",
    "realDomNotes": "按链路展示批次/状态/进度条",
    "riskPoints": []
  }
}