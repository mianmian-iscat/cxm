{
  "id": "normal-f88-production-dashboard-progress",
  "name": "正常流程：生产看板整体推送进度展示验证",
  "description": "验证生产看板展示：总任务数、生产失败任务数、审核丢弃任务数、生产超时任务数、生产中任务数、已推送任务数，及各链路进度数据口径一致",
  "businessType": "f88_material",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 50,
    "outputCompact": true
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开生产看板"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待看板加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "数据看板",
      "description": "验证数据看板标题"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "整体推送进度",
      "description": "验证整体推送进度区域"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "总任务数",
      "description": "验证总任务数展示"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "生产失败",
      "description": "验证生产失败任务数展示"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核丢弃",
      "description": "验证审核丢弃任务数展示"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "生产超时",
      "description": "验证生产超时任务数展示"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "生产中",
      "description": "验证生产中任务数展示"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "已推送",
      "description": "验证已推送任务数展示"
    },
    {
      "type": "screenshot",
      "label": "dashboard-progress",
      "description": "截图 - 生产看板整体进度"
    }
  ],
  "capture": {
    "enabled": true,
    "filter": "bzb.api.fsyx_quality_guard",
    "captureBody": true
  },
  "screenshot": {
    "onError": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发环境可访问，测试账号已登录，存在生产任务数据",
    "riskPoints": [
      "各链路进度展示数据口径需与整体进度一致",
      "生产失败含：刷标签失败/单图生图失败/首图生图失败/套图生图失败"
    ],
    "relatedDocs": [
      "F88主图素材供给产品方案 v3.0 20260623"
    ]
  },
  "source": "dingtalk-doc-MNDoBb60VLYDGNPytBE4qmgwJlemrZQ3",
  "sourceIds": null
}