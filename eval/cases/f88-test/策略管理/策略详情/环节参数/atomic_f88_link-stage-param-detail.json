{
  "id": "atomic-f88-link-stage-param-detail",
  "name": "UI：链路-环节参数详情弹窗结构验证",
  "description": "验证环节参数详情弹窗的入参取值配置、策略列表(含默认checkbox)、环节出参三大板块结构完整性",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "description": "打开链路详情(20180)"
    },
    {
      "type": "wait",
      "ms": 4000,
      "description": "等待链路详情加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "入参图刷标签",
      "description": "验证环节卡片存在"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const spans = Array.from(document.querySelectorAll('span')); const el = spans.find(s => (s.textContent || '').trim() === '入参'); if (!el) return { found: false }; const rect = el.getBoundingClientRect(); return { found: true, x: rect.x, y: rect.y, w: rect.width, h: rect.height }; })()",
      "description": "定位第1个'入参'span(入参图刷标签)",
      "storeAs": "inputLink"
    },
    {
      "type": "assertStore",
      "key": "inputLink",
      "path": "found",
      "equals": true,
      "description": "入参链接存在"
    },
    {
      "type": "click",
      "selector": "span",
      "text": "入参",
      "description": "点击'入参'打开环节参数详情弹窗",
      "useCoordinates": true,
      "coordinateSource": "inputLink"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待弹窗渲染"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "环节参数详情",
      "description": "验证弹窗标题"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "取 消",
      "description": "验证取消按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "保 存",
      "description": "验证保存按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "入参取值配置",
      "description": "验证入参取值配置板块"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "策略列表",
      "description": "验证策略列表板块"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "环节出参",
      "description": "验证环节出参板块"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "seller_id",
      "description": "验证seller_id参数"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "seed_image_url",
      "description": "验证seed_image_url参数"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "tao_cate",
      "description": "验证tao_cate参数"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "item_id",
      "description": "验证item_id参数"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "string",
      "description": "验证参数类型标注"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const drawer = document.querySelector('.ant-drawer'); if (!drawer) return { open: false }; const text = drawer.textContent || ''; const sections = { hasTitle: text.includes('环节参数详情'), hasInputConfig: text.includes('入参取值配置'), hasStrategyList: text.includes('策略列表'), hasOutput: text.includes('环节出参'), hasCancel: text.includes('取 消'), hasSave: text.includes('保 存') }; const params = ['seller_id', 'seed_image_url', 'tao_cate', 'item_id', 'back_img_url', 'skc_img_url']; const paramFound = params.filter(p => text.includes(p)); const checkboxes = Array.from(drawer.querySelectorAll('input[type=checkbox], .ant-checkbox')).length; const strategyItems = Array.from(drawer.querySelectorAll('[class*=strategy], [class*=Strategy]')).length; return { open: true, sections, paramCount: paramFound.length, params: paramFound, checkboxes, strategyItems }; })()",
      "description": "分析弹窗DOM结构完整性",
      "storeAs": "drawerCheck"
    },
    {
      "type": "assertStore",
      "key": "drawerCheck",
      "path": "open",
      "equals": true,
      "description": "验证弹窗已打开"
    },
    {
      "type": "assertStore",
      "key": "drawerCheck",
      "path": "sections.hasTitle",
      "equals": true,
      "description": "验证标题存在"
    },
    {
      "type": "assertStore",
      "key": "drawerCheck",
      "path": "sections.hasInputConfig",
      "equals": true,
      "description": "验证入参取值配置板块"
    },
    {
      "type": "assertStore",
      "key": "drawerCheck",
      "path": "sections.hasStrategyList",
      "equals": true,
      "description": "验证策略列表板块"
    },
    {
      "type": "assertStore",
      "key": "drawerCheck",
      "path": "sections.hasOutput",
      "equals": true,
      "description": "验证环节出参板块"
    },
    {
      "type": "assertStore",
      "key": "drawerCheck",
      "path": "sections.hasCancel",
      "equals": true,
      "description": "验证取消按钮"
    },
    {
      "type": "assertStore",
      "key": "drawerCheck",
      "path": "sections.hasSave",
      "equals": true,
      "description": "验证保存按钮"
    },
    {
      "type": "assertStore",
      "key": "drawerCheck",
      "path": "paramCount",
      "gte": 4,
      "description": "验证至少4个核心参数(seller_id/seed_image_url/tao_cate/item_id)"
    },
    {
      "type": "assertStore",
      "key": "drawerCheck",
      "path": "strategyItems",
      "gte": 1,
      "description": "验证至少有1个策略"
    },
    {
      "type": "assertStore",
      "key": "drawerCheck",
      "path": "checkboxes",
      "gte": 1,
      "description": "验证存在默认checkbox"
    },
    {
      "type": "screenshot",
      "label": "stage-param-detail",
      "description": "环节参数详情弹窗截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；链路id=20180存在",
    "realDomNotes": "弹窗为ant-drawer组件; 含'入参取值配置/策略列表/环节出参'三板块; 策略项含'默认'checkbox; 参数类型标注为string; 取消/保存按钮",
    "riskPoints": [
      "入参取值配置中{{stage.xxx}}占位符是否正确渲染",
      "策略列表默认checkbox是否全部勾选",
      "环节出参字段是否与入参一致(含新增的season_tag/style_tag)"
    ]
  }
}
