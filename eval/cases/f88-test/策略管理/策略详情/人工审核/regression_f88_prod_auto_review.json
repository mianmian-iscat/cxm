  "description": "打开策略详情，通过新增节点面板验证节点类型库含机审(按算法类型自动判断)、高清化处理、人工审核等生产/审核节点，并断言策略详情API成功。基于当前预发UI真实结构重设计。",
  "businessType": "f88_material",
  "scene": "f88-test",
  "priority": "P0",
  "category": "regression",
  "source": "qoderwork/f88-test/testcases_material_production.json",
  "sourceIds": ["MP-040", "MP-041", "MP-042"],
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail/10602",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail/10602",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略详情页（触发 strategy/get）"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待策略详情与节点编排渲染"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "节点编排",
      "description": "验证策略详情含节点编排区"
    },
    {
      "type": "clickText",
      "text": "新增节点",
      "description": "打开节点类型选择面板"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待节点类型库加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "机审",
      "description": "【MP-040】验证节点类型库含机审节点"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "机器审核节点，按算法类型自动判断",
      "description": "【MP-040/041/042】验证机审节点按算法类型自动判断是否通过"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "高清化处理",
      "description": "【MP-030】验证节点类型库含高清化处理节点"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "人工审核",
      "description": "验证节点类型库含人工审核节点"
    },
    {
      "type": "screenshot",
      "label": "node-type-library",
      "description": "截图-节点类型库（含机审/高清化）"
    },
    {
      "type": "pressKey",
      "key": "Escape",
      "description": "关闭节点类型面板（不实际添加节点，避免污染策略数据）"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待面板关闭"
    }
  ],
  "capture": {
    "enabled": true,
    "filter": "workflow2|strategy",
    "captureBody": true
  },
  "post_asserts": [
    {
      "type": "apiResponse",
      "urlPattern": "workflow2/strategy/get",
      "path": "success",
      "equals": true,
      "description": "【MP-040】验证策略详情接口 strategy/get 返回成功"
    }
  ],
  "screenshot": { "onError": true },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": { "status": "pass" },
  "_testDesign": {
    "preconditions": "F88预发环境已登录；存在任一含节点策略（当前用 strategy/detail/10602）。若被清理需替换。",
    "realDomNotes": "预发真实结构：机审为节点类型库中的一种（描述'机器审核节点，按算法类型自动判断是否通过'），高清化=节点'高清化处理'。当前预发无现成配置了机审节点的策略，AI_QUALITY/BAD_MATERIAL/CTR_RANKING 三种算法名需新增机审节点进入其配置面板才能读取；为避免污染策略数据（新增节点需保存才持久，反复试探不优雅），本用例仅验证到节点类型库层面，三算法名验证留待有现成机审策略时补充。策略详情API=/api/workflow2/strategy/get，响应顶层 success:true。",
    "riskPoints": ["三种机审算法名未强制断言(需现成机审策略)", "策略数据依赖10602", "节点类型库中文标签定位"],
    "qoderworkRef": "testcases_material_production.json MP-040/MP-041/MP-042"
  }
}
