{
  "id": "atomic-f88-sd-db-config",
  "name": "UI：策略详情-落库配置区域验证",
  "description": "验证策略详情End节点的落库配置：已映射字段数/配置按钮",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail/10568"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail/10568",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略详情"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const t = document.body.innerText; const dbMatch = t.match(/已映射\\s*(\\d+)\\s*个字段/); const configBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('配 置') || b.textContent.includes('配置')); const hasNoConfig = t.includes('暂未配置落库映射'); return { hasDbConfig: t.includes('落库配置'), mappedFields: dbMatch?.[1] || '0', hasConfigBtn: !!configBtn, hasNoConfig: hasNoConfig }; })()",
      "description": "验证落库配置",
      "storeAs": "dbInfo"
    },
    {
      "type": "assertStore",
      "key": "dbInfo",
      "path": "found",
      "equals": true,
      "description": "验证 验证落库配置 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "策略",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "dbInfo",
      "path": "hasDbConfig",
      "equals": true,
      "description": "验证落库配置区域存在"
    },
    {
      "type": "screenshot",
      "label": "sd-db-config",
      "description": "落库配置区域"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在相关数据",
    "realDomNotes": "落库配置显示已映射字段数，配置按钮",
    "riskPoints": []
  }
}