{
  "id": "ui-f88-strategy-detail-storage",
  "name": "UI：策略详情-落库配置验证",
  "description": "验证策略详情页落库配置区域：配置项展示/编辑/保存，数据一致性",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail?id=20180",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/detail?id=20180",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略详情"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const text = document.body.innerText; const hasStorage = text.includes('落库') || text.includes('存储') || text.includes('storage'); return { hasStorageSection: hasStorage }; })()",
      "description": "检查落库配置区域",
      "storeAs": "storageCheck"
    },
    {
      "type": "assertStore",
      "key": "storageCheck",
      "path": "found",
      "equals": true,
      "description": "验证 检查落库配置区域 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "策略",
      "description": "验证页面已加载"
    },
    {
      "type": "screenshot",
      "label": "strategy-detail-storage",
      "description": "落库配置区域"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const saveBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('保存')); return { found: !!saveBtn }; })()",
      "description": "查找保存按钮",
      "storeAs": "saveBtn"
    },
    {
      "type": "assertStore",
      "key": "saveBtn",
      "path": "found",
      "equals": true,
      "description": "验证 查找保存按钮 存在"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；策略ID=20180存在。",
    "realDomNotes": "策略详情包含3个区域：策略基本信息/节点编排/落库配置。保存按钮在页面顶部或底部。",
    "riskPoints": [
      "落库配置区域可能需要滚动才能看到"
    ]
  }
}