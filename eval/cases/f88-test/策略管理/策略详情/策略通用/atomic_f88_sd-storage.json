{
  "id": "atomic-f88-sd-storage",
  "name": "UI：策略详情-落库配置验证",
  "description": "验证策略详情页落库配置区域展示",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略列表"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const btns = Array.from(document.querySelectorAll('a,button')).filter(el => el.textContent.trim() === '打开'); if(btns.length > 0) { btns[0].click(); return 'clicked'; } return 'no open btn'; })()",
      "description": "打开第一条策略"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const hasStorage = t.includes('落库配置') || t.includes('落库'); return { hasStorage }; })()",
      "description": "验证落库配置区域",
      "storeAs": "storageSection"
    },
    {
      "type": "assertStore",
      "key": "storageSection",
      "path": "hasStorage",
      "equals": true,
      "description": "验证落库配置区域存在"
    },
    {
      "type": "screenshot",
      "label": "sd-storage",
      "description": "落库配置"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在策略数据",
    "realDomNotes": "落库配置区域",
    "riskPoints": []
  }
}