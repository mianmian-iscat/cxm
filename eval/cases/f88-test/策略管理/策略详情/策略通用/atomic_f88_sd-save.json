{
  "id": "atomic-f88-sd-save",
  "name": "UI：策略详情-保存按钮验证",
  "description": "验证策略详情页保存按钮存在",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略列表"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const btns = Array.from(document.querySelectorAll('a,button')).filter(el => el.textContent.trim() === '打开'); if(btns.length > 0) { btns[0].click(); return 'clicked'; } return 'no open btn'; })()",
      "description": "打开第一条策略"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const btns = Array.from(document.querySelectorAll('button,a')).filter(el => el.textContent.trim().match(/保.*存/)); return { count: btns.length, texts: btns.map(b => b.textContent.trim()) }; })()",
      "description": "查找保存按钮",
      "storeAs": "saveBtn"
    },
    {
      "type": "assertStore",
      "key": "saveBtn",
      "path": "count",
      "notEmpty": true,
      "description": "验证保存按钮存在"
    },
    {
      "type": "screenshot",
      "label": "sd-save",
      "description": "保存按钮"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在策略数据",
    "realDomNotes": "保存按钮文案可能含空格'保 存'，用正则匹配",
    "riskPoints": []
  }
}