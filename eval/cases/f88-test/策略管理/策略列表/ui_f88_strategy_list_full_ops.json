{
  "id": "ui-f88-strategy-list-full-ops",
  "name": "UI：策略列表-筛选/新建/打开/复制全功能验证",
  "description": "验证策略列表：策略阶段筛选/环节筛选/新建策略/策略卡片操作(打开/复制)，数据一致性",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略列表"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "策略",
      "description": "验证页面包含策略"
    },
    {
      "type": "selectOption",
      "label": "策略阶段",
      "option": "实验",
      "description": "筛选实验阶段"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "screenshot",
      "label": "strategy-list-stage-exp",
      "description": "实验阶段筛选"
    },
    {
      "type": "selectOption",
      "label": "环节",
      "option": "视觉",
      "description": "筛选视觉环节"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "screenshot",
      "label": "strategy-list-process-visual",
      "description": "视觉环节筛选"
    },
    {
      "type": "clickText",
      "text": "新建策略",
      "description": "点击新建策略"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待加载"
    },
    {
      "type": "screenshot",
      "label": "strategy-list-create",
      "description": "新建策略"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const closeBtn = document.querySelector('.ant-modal-close, .ant-drawer-close'); if(closeBtn) closeBtn.click(); return 'closed'; })()",
      "description": "关闭"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const actions = Array.from(document.querySelectorAll('a, button')).filter(el => { const t = el.textContent.trim(); return ['打开', '复制'].some(k => t.includes(k)); }); return actions.map(a => ({ text: a.textContent.trim() })); })()",
      "description": "提取策略操作按钮",
      "storeAs": "stratActions"
    },
    {
      "type": "screenshot",
      "label": "strategy-list-actions",
      "description": "策略操作按钮"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在策略数据。",
    "realDomNotes": "筛选：策略阶段(全部/实验/灰度/正式)/环节(全部/视觉/设计/视频)。按钮：新建策略。卡片操作：打开/复制。",
    "riskPoints": [
      "复制需确认弹窗"
    ]
  }
}