{
  "id": "atomic-f88-sl-create",
  "name": "UI：策略列表-新建策略入口验证",
  "description": "点击新建策略按钮，验证弹窗或页面跳转",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略列表"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "新建策略",
      "description": "点击新建策略"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { return { hasModal: !!document.querySelector('.ant-modal:not(.ant-modal-hidden)'), hasDrawer: !!document.querySelector('.ant-drawer'), url: location.href }; })()",
      "description": "验证新建入口",
      "storeAs": "createResult"
    },
    {
      "type": "screenshot",
      "label": "sl-create",
      "description": "新建策略"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const close = document.querySelector('.ant-modal-close,.ant-drawer-close'); if(close) close.click(); return 'closed'; })()",
      "description": "关闭"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在策略数据",
    "realDomNotes": "新建策略可能为弹窗或页面跳转",
    "riskPoints": []
  }
}