{
  "id": "atomic-f88-sl-fields",
  "name": "UI：策略列表-策略卡片字段完整性验证",
  "description": "验证策略卡片展示所有必要字段",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略列表"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const t = document.body.innerText; const fields = ['策略名称','策略阶段','环节','创建时间','更新时间','提交人']; const found = fields.filter(f => t.includes(f)); return { fields, found, missing: fields.filter(f => !t.includes(f)), coverage: found.length+'/'+fields.length }; })()",
      "description": "验证字段完整性",
      "storeAs": "fieldCheck"
    },
    {
      "type": "assertStore",
      "key": "fieldCheck",
      "path": "found",
      "equals": true,
      "description": "验证 验证字段完整性 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "列表",
      "description": "验证页面已加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const ths = Array.from(document.querySelectorAll('th, .ant-table-thead th')); return { columnCount: ths.length, headers: ths.slice(0, 15).map(th => (th.textContent || '').trim()) }; })()",
      "description": "检查表格列信息",
      "storeAs": "fieldCheckInfo"
    },
    {
      "type": "screenshot",
      "label": "sl-fields",
      "description": "策略字段截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在策略数据",
    "realDomNotes": "字段: 策略名称/策略阶段/环节/创建时间/更新时间/提交人",
    "riskPoints": []
  }
}