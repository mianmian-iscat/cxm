{
  "id": "atom-f88-sl-stage-filter",
  "name": "原子：策略列表-策略阶段筛选选项验证",
  "description": "验证策略阶段下拉包含全部/实验/灰度/正式选项",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const selects = document.querySelectorAll('.ant-select'); return { count: selects.length }; })()",
      "description": "记录Select数量",
      "storeAs": "slSelects"
    },
    {
      "type": "assertStore",
      "key": "slSelects",
      "path": "found",
      "equals": true,
      "description": "验证 记录Select数量 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "列表",
      "description": "验证页面已加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const ths = Array.from(document.querySelectorAll('th, .ant-table-thead th')); return { columnCount: ths.length, headers: ths.slice(0, 15).map(th => (th.textContent || '').trim()) }; })()",
      "description": "检查表格列信息",
      "storeAs": "slSelectsInfo"
    },
    {
      "type": "screenshot",
      "label": "sl-stage-filter",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "",
    "realDomNotes": "",
    "riskPoints": [
      "无数据时为空"
    ]
  }
}