{
  "id": "atomic-f88-sl-page-load",
  "name": "UI：策略列表-页面加载与文案完整性",
  "description": "验证策略列表页面标题、筛选区、策略卡片字段",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略列表"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "策略",
      "description": "验证页面包含策略"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const fields = ['策略名称','策略阶段','环节','创建时间','提交人']; const found = fields.filter(f => t.includes(f)); return { fields, found, coverage: found.length+'/'+fields.length }; })()",
      "description": "验证字段文案",
      "storeAs": "fieldCheck"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const cards = Array.from(document.querySelectorAll('[class*=card],[class*=strategy]')).slice(0,5).map(c => c.textContent.trim().substring(0,120)); return { cards, count: cards.length }; })()",
      "description": "提取策略卡片",
      "storeAs": "stratCards"
    },
    {
      "type": "screenshot",
      "label": "sl-page-load",
      "description": "策略列表页面"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在策略数据",
    "realDomNotes": "字段: 策略名称/策略阶段/环节/创建时间/更新时间/提交人",
    "riskPoints": []
  }
}