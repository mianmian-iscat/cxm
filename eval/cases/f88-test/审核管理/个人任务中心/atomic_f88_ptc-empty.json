{
  "id": "atomic-f88-ptc-empty",
  "name": "UI：个人任务中心-空状态展示验证",
  "description": "验证无任务数据时的空状态展示",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开个人任务中心"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const empty = document.querySelector('.ant-empty,[class*=empty],[class*=no-data]'); return { hasEmpty: !!empty, text: empty ? empty.textContent.trim() : null }; })()",
      "description": "检查空状态组件",
      "storeAs": "emptyState"
    },
    {
      "type": "assertStore",
      "key": "emptyState",
      "path": "found",
      "equals": true,
      "description": "验证 检查空状态组件 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核",
      "description": "验证页面已加载"
    },
    {
      "type": "screenshot",
      "label": "ptc-empty",
      "description": "空状态截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；当前无待处理任务",
    "realDomNotes": "",
    "riskPoints": []
  }
}