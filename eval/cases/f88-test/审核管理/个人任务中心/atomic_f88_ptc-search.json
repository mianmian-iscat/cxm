{
  "id": "atomic-f88-ptc-search",
  "name": "UI：个人任务中心-任务搜索功能验证",
  "description": "在任务列表中进行搜索，验证搜索框响应和结果过滤",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开个人任务中心"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const inputs = Array.from(document.querySelectorAll('input')); return inputs.map(i => ({ placeholder: i.placeholder, type: i.type })); })()",
      "description": "探查搜索框",
      "storeAs": "searchInputs"
    },
    {
      "type": "assertStore",
      "key": "searchInputs",
      "path": "placeholder",
      "notEmpty": true,
      "description": "验证搜索框存在"
    },
    {
      "type": "fill",
      "selector": "input[placeholder='请输入']",
      "value": "测试",
      "react": true,
      "description": "输入搜索关键词"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待加载"
    },
    {
      "type": "screenshot",
      "label": "ptc-search-result",
      "description": "搜索结果截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；个人任务中心有任务数据",
    "realDomNotes": "搜索框为React受控组件，fill必须react:true",
    "riskPoints": []
  }
}