{
  "id": "atomic-f88-ptc-list-fields",
  "name": "UI：个人任务中心-任务列表字段完整性验证",
  "description": "验证任务列表展示所有必要字段：任务编号/任务名称/审核类型/日期",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开个人任务中心"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const items = Array.from(document.querySelectorAll('[class*=task],[class*=list] li,[class*=card]')).slice(0,3).map(el => el.textContent.trim().substring(0,150)); return { items, count: items.length }; })()",
      "description": "提取任务条目",
      "storeAs": "taskItems"
    },
    {
      "type": "assertStore",
      "key": "taskItems",
      "path": "count",
      "notEmpty": true,
      "description": "验证任务列表非空"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const fields = ['任务编号','任务名称','审核类型']; const found = fields.filter(f => t.includes(f)); return { fields, found, coverage: found.length+'/'+fields.length }; })()",
      "description": "验证字段文案",
      "storeAs": "fieldCheck"
    },
    {
      "type": "screenshot",
      "label": "ptc-list-fields",
      "description": "列表字段截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；个人任务中心有任务数据",
    "realDomNotes": "任务字段: 任务编号/任务名称/审核类型/日期",
    "riskPoints": []
  }
}