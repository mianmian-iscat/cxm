{
  "id": "atom-f88-ptc-tab-audit",
  "name": "原子：个人任务中心-审核任务Tab文案验证",
  "description": "验证'审核任务'Tab文案正确且默认选中",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const tabs = Array.from(document.querySelectorAll('.ant-tabs-tab')); const audit = tabs.find(t => t.textContent.includes('审核任务') && !t.textContent.includes('抽检') && !t.textContent.includes('埋雷')); return { found: !!audit, text: audit?.textContent?.trim(), active: audit?.classList?.contains('ant-tabs-tab-active') }; })()",
      "description": "验证审核任务Tab",
      "storeAs": "auditTab"
    },
    {
      "type": "assertStore",
      "key": "auditTab",
      "path": "found",
      "equals": true,
      "description": "验证 验证审核任务Tab 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "auditTab",
      "path": "found",
      "equals": true
    },
    {
      "type": "screenshot",
      "label": "ptc-tab-audit",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "",
    "realDomNotes": "",
    "riskPoints": [
      "无数据时为空"
    ]
  }
}