    { "type": "wait", "ms": 1500, "description": "等待新增标准弹窗渲染" },
    { "type": "assert", "target": "page", "contains": "标准", "description": "验证新增标准弹窗已打开" },
    { "type": "assert", "target": "page", "contains": "名称", "description": "验证标准名称字段" },
    { "type": "screenshot", "label": "f88-create-standard-form", "description": "截图-新增标准表单" },
