{
  "id": "atomic-f88-std-page-load",
  "name": "UI：审核标准管理-页面加载与文案完整性",
  "description": "验证页面标题、表格列名、按钮文案完整",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/standard-management",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/standard-management",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开审核标准管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核标准管理",
      "description": "验证页面标题"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const headers = Array.from(document.querySelectorAll('th')).map(th => th.textContent.trim()); return { headers, count: headers.length }; })()",
      "description": "获取表格列名",
      "storeAs": "headers"
    },
    {
      "type": "assertStore",
      "key": "headers",
      "path": "count",
      "notEmpty": true,
      "description": "验证列名非空"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const btns = Array.from(document.querySelectorAll('a,button')).filter(el => ['重置','新增标准'].some(t => el.textContent.trim().includes(t))); return btns.map(b => ({ text: b.textContent.trim(), tag: b.tagName })); })()",
      "description": "获取按钮",
      "storeAs": "btns"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "重置",
      "description": "验证重置按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "新增标准",
      "description": "验证新增标准按钮"
    },
    {
      "type": "screenshot",
      "label": "std-page-load",
      "description": "审核标准管理页面"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在审核标准数据",
    "realDomNotes": "字段: 标准名称/创建人/创建时间/使用次数/状态/操作",
    "riskPoints": []
  }
}