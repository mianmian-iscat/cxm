{
  "id": "atom-f88-as-toggle-btn",
  "name": "原子：审核标准管理-启用/禁用按钮文案验证",
  "description": "验证操作列包含'启用'或'禁用'按钮/Switch组件",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/standard-management",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/standard-management",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const toggles = Array.from(document.querySelectorAll('a, button, .ant-switch')).filter(el => { const t = el.textContent.trim(); return t.includes('启用') || t.includes('禁用'); }); const switches = document.querySelectorAll('.ant-switch'); return { toggleBtns: toggles.length, switches: switches.length }; })()",
      "description": "验证启用禁用",
      "storeAs": "asToggle"
    },
    {
      "type": "assertStore",
      "key": "asToggle",
      "path": "found",
      "equals": true,
      "description": "验证 验证启用禁用 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核",
      "description": "验证页面已加载"
    },
    {
      "type": "screenshot",
      "label": "as-toggle",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "",
    "realDomNotes": "",
    "riskPoints": [
      "无数据时为空"
    ]
  }
}