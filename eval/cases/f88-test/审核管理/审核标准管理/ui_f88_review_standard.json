    "auth": "buc"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/standard-management",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开审核标准管理页"
    },
    { "type": "wait", "ms": 2500, "description": "等待审核标准表格加载" },
    { "type": "assert", "target": "page", "contains": "审核标准管理", "description": "验证审核标准管理页已加载" },
    { "type": "assert", "target": "page", "contains": "新建标准", "description": "验证含新建标准入口" },
    { "type": "assert", "target": "page", "contains": "标准名称", "description": "验证表格含标准名称列" },
    { "type": "assert", "target": "page", "contains": "使用次数", "description": "验证表格含使用次数列" },
    { "type": "assert", "target": "page", "contains": "查看详情", "description": "验证含查看详情操作" },
    { "type": "screenshot", "label": "review-standard", "description": "截图-审核标准管理页" }
  ],
  "screenshot": { "onError": true },
  "contextOptimization": { "screenshotExternal": true, "maxResponseSizeKb": 100, "outputCompact": true },
  "_expected": { "status": "pass" },
  "_testDesign": {
    "preconditions": "F88预发已登录（buc）。",
    "realDomNotes": "真实路由 /review/standard-management；表格列：标准名称/创建人/创建时间/使用次数/操作；按钮：新建标准/重置/搜索/查看详情/编辑；筛选：标准名称、创建人。",
    "riskPoints": ["表格数据为空时仅表头存在"]
  }
}
