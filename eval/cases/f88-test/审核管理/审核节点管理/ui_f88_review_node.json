  "description": "打开审核节点管理，验证表格列（节点名称/审核标准/人效预估/分配方式等）与新建审核节点入口。基于预发真实路由 /review/node-management。",
  "businessType": "f88_material",
  "scene": "f88-test",
  "priority": "P1",
  "category": "smoke",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
