{
  "id": "atomic-f88-node-sort",
  "name": "UI：审核节点管理-排序功能验证",
  "description": "验证节点排序控件存在及拖拽排序",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开审核节点管理"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const sortIcons = document.querySelectorAll('[class*=sort],[class*=drag],[class*=handle]'); const sortBtns = Array.from(document.querySelectorAll('a,button')).filter(el => el.textContent.trim().includes('排序')); return { sortIcons: sortIcons.length, sortBtns: sortBtns.length }; })()",
      "description": "查找排序控件",
      "storeAs": "sortControls"
    },
    {
      "type": "assertStore",
      "key": "sortControls",
      "path": "found",
      "equals": true,
      "description": "验证 查找排序控件 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核",
      "description": "验证页面已加载"
    },
    {
      "type": "screenshot",
      "label": "node-sort",
      "description": "排序控件截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在审核节点数据",
    "realDomNotes": "排序: 初审→复审→终审",
    "riskPoints": []
  }
}