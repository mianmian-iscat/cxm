{
  "id": "atomic-f88-node-std-link",
  "name": "UI：审核节点管理-关联审核标准字段验证",
  "description": "验证节点关联的审核标准字段正确展示",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开审核节点管理"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const headers = Array.from(document.querySelectorAll('th')).map(th => th.textContent.trim()); const hasStdCol = headers.some(h => h.includes('标准') || h.includes('审核标准')); const rows = Array.from(document.querySelectorAll('tbody tr')).slice(0,3).map(tr => { const cells = Array.from(tr.querySelectorAll('td')).map(td => td.textContent.trim()); return { cells }; }); return { headers, hasStdCol, rows }; })()",
      "description": "探查关联标准字段",
      "storeAs": "stdLink"
    },
    {
      "type": "assertStore",
      "key": "stdLink",
      "path": "found",
      "equals": true,
      "description": "验证 探查关联标准字段 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "stdLink",
      "path": "hasStdCol",
      "equals": true,
      "description": "验证存在审核标准列"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const ths = Array.from(document.querySelectorAll('th, .ant-table-thead th')); return { columnCount: ths.length, headers: ths.slice(0, 15).map(th => (th.textContent || '').trim()) }; })()",
      "description": "检查表格列信息",
      "storeAs": "tableInfo"
    },
    {
      "type": "screenshot",
      "label": "node-std-link",
      "description": "关联标准字段截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在审核节点数据",
    "realDomNotes": "节点需关联审核标准",
    "riskPoints": []
  }
}