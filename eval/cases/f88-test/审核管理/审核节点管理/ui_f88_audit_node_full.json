{
  "id": "ui-f88-audit-node-full",
  "name": "UI：审核节点管理-页面加载/新增/编辑/排序/关联标准验证",
  "description": "验证审核节点管理：表格列名/新增节点弹窗/编辑/排序/关联审核标准，数据一致性",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开审核节点管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核节点管理",
      "description": "验证页面标题"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const headers = Array.from(document.querySelectorAll('th')).map(th => th.textContent.trim()); return { headers }; })()",
      "description": "记录表格列名",
      "storeAs": "nodeHeaders"
    },
    {
      "type": "screenshot",
      "label": "audit-node-page",
      "description": "审核节点管理页面"
    },
    {
      "type": "clickText",
      "text": "新增节点",
      "description": "点击新增节点"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const modal = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); return { hasModal: !!modal, title: modal ? modal.querySelector('.ant-modal-title')?.textContent?.trim() : null }; })()",
      "description": "验证新增节点弹窗",
      "storeAs": "addNodeModal"
    },
    {
      "type": "assertStore",
      "key": "addNodeModal",
      "path": "hasModal",
      "equals": true,
      "description": "断言新增节点弹窗出现"
    },
    {
      "type": "screenshot",
      "label": "audit-node-add-modal",
      "description": "新增节点弹窗"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const closeBtn = document.querySelector('.ant-modal-close'); if(closeBtn) closeBtn.click(); return 'closed'; })()",
      "description": "关闭弹窗"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const editBtns = Array.from(document.querySelectorAll('a, button')).filter(el => el.textContent.trim() === '编辑'); if(editBtns.length > 0) { editBtns[0].click(); return 'clicked'; } return 'no btn'; })()",
      "description": "点击编辑"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待加载"
    },
    {
      "type": "screenshot",
      "label": "audit-node-edit",
      "description": "编辑节点"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const closeBtn = document.querySelector('.ant-modal-close'); if(closeBtn) closeBtn.click(); return 'closed'; })()",
      "description": "关闭弹窗"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在审核节点数据。",
    "realDomNotes": "表格列：节点名称/审核标准/人效预估/难度预估/分配方式/审核人/检查设置/操作。操作：编辑/排序/关联标准。",
    "riskPoints": [
      "排序可能为拖拽操作"
    ]
  }
}