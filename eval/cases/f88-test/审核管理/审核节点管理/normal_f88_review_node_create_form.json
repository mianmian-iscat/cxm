{
  "id": "normal-f88-review-node-create-form",
  "name": "正常流程：F88 审核节点管理-新增节点表单结构验证",
  "description": "打开审核节点管理页，点击新增节点，验证弹窗表单字段（节点类型20种选择、节点编排区域等）。",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开审核节点管理页"
    },
    { "type": "wait", "ms": 3000, "description": "等待节点列表加载" },
    { "type": "assert", "target": "page", "contains": "新增", "description": "验证新增节点按钮存在" },
    { "type": "clickText", "text": "新增", "description": "点击新增节点按钮" },
    { "type": "wait", "ms": 1500, "description": "等待新增节点弹窗渲染" },
    { "type": "assert", "target": "page", "contains": "节点", "description": "验证新增节点弹窗已打开" },
    { "type": "assert", "target": "page", "contains": "节点类型", "description": "验证节点类型选择字段" },
    { "type": "screenshot", "label": "f88-create-node-form", "description": "截图-新增节点表单" },
    { "type": "clickText", "text": "取消", "description": "取消不提交" }
  ],
  "screenshot": { "onError": true },
  "contextOptimization": { "screenshotExternal": true, "maxResponseSizeKb": 100, "outputCompact": true },
  "_expected": { "status": "pass" },
  "_testDesign": {
    "preconditions": "F88预发已登录（buc）。",
    "realDomNotes": "tc16_add_node 对应；新增节点弹窗字段：节点类型（20种含生图/高清化/AI机审/人工审核等）、节点编排区域；questionType=4为首图审核多选多模式。",
    "riskPoints": ["新增按钮文案可能含空格（'新 增'）", "节点类型选项列表动态加载"]
  }
}
