{
  "id": "atomic-f88-node-page-load",
  "name": "UI：审核节点管理-页面加载与文案完整性",
  "description": "验证页面标题、表格列名、新增节点按钮",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开审核节点管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核节点管理",
      "description": "验证页面标题"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const headers = Array.from(document.querySelectorAll('th')).map(th => th.textContent.trim()); return { headers, count: headers.length }; })()",
      "description": "获取表格列名",
      "storeAs": "headers"
    },
    {
      "type": "assertStore",
      "key": "headers",
      "path": "count",
      "notEmpty": true,
      "description": "验证列名非空"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "新增节点",
      "description": "验证新增节点按钮"
    },
    {
      "type": "screenshot",
      "label": "node-page-load",
      "description": "审核节点管理页面"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在审核节点数据",
    "realDomNotes": "字段: 节点名称/审核标准/人效预估/难度预估/分配方式/审核人/检查设置",
    "riskPoints": []
  }
}