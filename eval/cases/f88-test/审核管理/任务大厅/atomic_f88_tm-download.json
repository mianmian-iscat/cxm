{
  "id": "atomic-f88-tm-download",
  "name": "UI：任务管理-下载操作验证",
  "description": "点击下载链接，验证下载触发",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开任务管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const arrows = document.querySelectorAll('.ant-tree-switcher:not(.ant-tree-switcher-noop)'); arrows.forEach(a => a.click()); return 'expanded'; })()",
      "description": "展开所有节点"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const btns = Array.from(document.querySelectorAll('a,button')).filter(el => el.textContent.trim() === '下载'); return { count: btns.length }; })()",
      "description": "查找下载按钮",
      "storeAs": "dlBtns"
    },
    {
      "type": "assertStore",
      "key": "dlBtns",
      "path": "count",
      "notEmpty": true,
      "description": "验证下载按钮存在"
    },
    {
      "type": "screenshot",
      "label": "tm-download",
      "description": "下载按钮"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在任务管理数据",
    "realDomNotes": "下载任务相关数据",
    "riskPoints": []
  }
}