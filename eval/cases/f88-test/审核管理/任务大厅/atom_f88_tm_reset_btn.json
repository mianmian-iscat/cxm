{
  "id": "atom-f88-tm-reset-btn",
  "name": "原子：任务管理-重置按钮文案与功能验证",
  "description": "验证'重置'按钮文案正确，点击后清空筛选条件",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const btn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('重置')); return { found: !!btn, text: btn?.textContent?.trim() }; })()",
      "description": "验证重置按钮",
      "storeAs": "resetBtn"
    },
    {
      "type": "assertStore",
      "key": "resetBtn",
      "path": "found",
      "equals": true,
      "description": "验证 验证重置按钮 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "resetBtn",
      "path": "found",
      "equals": true
    },
    {
      "type": "clickText",
      "text": "重置",
      "description": "点击重置按钮"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待操作响应"
    },
    {
      "type": "screenshot",
      "label": "after-click-action",
      "description": "点击重置后截图"
    },
    {
      "type": "screenshot",
      "label": "tm-reset-btn",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
