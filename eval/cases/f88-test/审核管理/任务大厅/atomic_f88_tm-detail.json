{
  "id": "atomic-f88-tm-detail",
  "name": "UI：任务管理-详情操作验证",
  "description": "点击详情链接，验证进入任务详情页",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开任务管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const arrows = document.querySelectorAll('.ant-tree-switcher:not(.ant-tree-switcher-noop)'); arrows.forEach(a => a.click()); return 'expanded'; })()",
      "description": "展开所有节点"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const btns = Array.from(document.querySelectorAll('a,button')).filter(el => el.textContent.trim() === '详情'); if(btns.length > 0) { btns[0].click(); return 'clicked'; } return 'no btn'; })()",
      "description": "点击详情",
      "storeAs": "clickResult"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { return { url: location.href, hasContent: document.body.innerText.length > 100 }; })()",
      "description": "验证详情页",
      "storeAs": "detailResult"
    },
    {
      "type": "assertStore",
      "key": "detailResult",
      "path": "hasContent",
      "equals": true,
      "description": "验证详情页有内容"
    },
    {
      "type": "screenshot",
      "label": "tm-detail",
      "description": "任务详情"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在任务管理数据",
    "realDomNotes": "详情页展示任务完整信息",
    "riskPoints": []
  }
}