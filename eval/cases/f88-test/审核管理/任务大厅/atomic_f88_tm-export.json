{
  "id": "atomic-f88-tm-export",
  "name": "UI：任务管理-批量导出功能验证",
  "description": "验证批量导出按钮存在及导出流程",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开任务管理"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const btns = Array.from(document.querySelectorAll('a,button')).filter(el => ['导出','批量导出','Excel'].some(t => el.textContent.trim().includes(t))); return btns.map(b => ({ text: b.textContent.trim(), tag: b.tagName })); })()",
      "description": "查找导出按钮",
      "storeAs": "exportBtns"
    },
    {
      "type": "assertStore",
      "key": "exportBtns",
      "path": "found",
      "equals": true,
      "description": "验证 查找导出按钮 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核",
      "description": "验证页面已加载"
    },
    {
      "type": "clickText",
      "text": "批量",
      "description": "点击批量按钮"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待操作响应"
    },
    {
      "type": "screenshot",
      "label": "after-click-exportBtns",
      "description": "点击批量后截图"
    },
    {
      "type": "screenshot",
      "label": "tm-export",
      "description": "导出按钮截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在任务管理数据",
    "realDomNotes": "批量导出为Excel格式",
    "riskPoints": []
  }
}