{
  "id": "atomic-f88-tm-batch-input",
  "name": "UI：任务管理-批次输入框筛选验证",
  "description": "在批次输入框中输入批次ID进行筛选",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开任务管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const inputs = Array.from(document.querySelectorAll('input')).filter(i => i.placeholder && i.placeholder.includes('请输入')); return inputs.map(i => ({ placeholder: i.placeholder, hasSearchIcon: !!i.closest('.ant-input-affix-wrapper') })); })()",
      "description": "查找批次输入框",
      "storeAs": "batchInputs"
    },
    {
      "type": "assertStore",
      "key": "batchInputs",
      "notEmpty": true,
      "description": "验证批次输入框存在"
    },
    {
      "type": "fill",
      "selector": "input[placeholder='请输入']",
      "value": "BT_6356",
      "react": true,
      "description": "输入批次ID"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "screenshot",
      "label": "tm-batch-filter",
      "description": "批次筛选结果"
    },
    {
      "type": "clickText",
      "text": "重置",
      "description": "重置筛选"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待加载"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在任务管理数据",
    "realDomNotes": "批次输入框带搜索图标，React受控组件",
    "riskPoints": []
  }
}