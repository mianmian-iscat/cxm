{
  "id": "ui-f88-task-management-schedule",
  "name": "UI：任务管理-查看任务排期按钮验证",
  "description": "点击右上角查看任务排期按钮，验证跳转/弹窗正确，排期数据展示完整",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "capture",
      "action": "start",
      "description": "开始抓包-排期"
    },
    {
      "type": "clickText",
      "text": "查看任务排期",
      "description": "点击查看任务排期"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待排期页面/弹窗"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const url = window.location.href; const modal = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); const drawer = document.querySelector('.ant-drawer:not(.ant-drawer-hidden)'); return { url, hasModal: !!modal, hasDrawer: !!drawer, urlChanged: url.includes('schedule') || url.includes('排期') }; })()",
      "description": "验证排期跳转/弹窗",
      "storeAs": "scheduleResult"
    },
    {
      "type": "screenshot",
      "label": "task-mgmt-schedule",
      "description": "任务排期截图"
    },
    {
      "type": "capture",
      "action": "stop",
      "description": "停止抓包"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录。",
    "realDomNotes": "查看任务排期可能跳转到/review/task-schedule页面或打开弹窗/Drawer。",
    "riskPoints": [
      "排期页面可能需要特定权限"
    ]
  }
}