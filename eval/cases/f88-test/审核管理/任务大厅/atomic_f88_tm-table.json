{
  "id": "atomic-f88-tm-table",
  "name": "UI：任务管理-表格列名完整性验证",
  "description": "验证任务管理表格包含所有必要列",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开任务管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const headers = Array.from(document.querySelectorAll('th')).map(th => th.textContent.trim()); return { headers, count: headers.length }; })()",
      "description": "获取表格列名",
      "storeAs": "headers"
    },
    {
      "type": "assertStore",
      "key": "headers",
      "path": "count",
      "notEmpty": true,
      "description": "验证列名非空"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const cols = ['预期交付时间','审核状态','抽检状态','埋雷状态','任务时长','操作']; const found = cols.filter(c => t.includes(c)); return { cols, found, coverage: found.length+'/'+cols.length }; })()",
      "description": "验证实际列名文案",
      "storeAs": "colCheck"
    },
    {
      "type": "screenshot",
      "label": "tm-table",
      "description": "表格结构截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在任务管理数据",
    "realDomNotes": "实际列: 任务名称/预期交付时间/审核状态&进度/抽检状态&进度/埋雷状态&进度/任务时长(除埋雷)/操作",
    "riskPoints": []
  }
}