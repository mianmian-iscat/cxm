{
  "id": "atom-f88-tm-action-allocate",
  "name": "原子：任务管理-分配明细按钮文案与可点击验证",
  "description": "验证任务行'分配明细'按钮文案正确且为蓝色链接",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待"
    },
    {
      "type": "evaluate",
      "expression": "(() => { document.querySelectorAll('.ant-tree-switcher:not(.ant-tree-switcher-noop)').forEach(a => a.click()); })()",
      "description": "展开"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const btn = Array.from(document.querySelectorAll('a')).find(a => a.textContent.trim() === '分配明细'); return { found: !!btn, text: btn?.textContent?.trim(), isLink: btn?.tagName === 'A' }; })()",
      "description": "验证分配明细按钮",
      "storeAs": "allocBtn"
    },
    {
      "type": "assertStore",
      "key": "allocBtn",
      "path": "found",
      "equals": true
    },
    {
      "type": "screenshot",
      "label": "tm-action-allocate",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
