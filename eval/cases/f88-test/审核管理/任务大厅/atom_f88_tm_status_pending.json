{
  "id": "atom-f88-tm-status-pending",
  "name": "原子：任务管理-审核状态'待开始'标签文案验证",
  "description": "验证任务行审核状态标签显示'待开始'且带圆点标记",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待"
    },
    {
      "type": "evaluate",
      "expression": "(() => { document.querySelectorAll('.ant-tree-switcher:not(.ant-tree-switcher-noop)').forEach(a => a.click()); })()",
      "description": "展开"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const text = document.body.innerText; return { hasPending: text.includes('待开始'), hasInProgress: text.includes('进行中') || text.includes('审核中'), hasDone: text.includes('已完成') || text.includes('已通过') }; })()",
      "description": "验证状态标签",
      "storeAs": "statusLabels"
    },
    {
      "type": "screenshot",
      "label": "tm-status-labels",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "",
    "realDomNotes": "",
    "riskPoints": [
      "无数据时为空"
    ]
  }
}