{
  "id": "atom-f88-tm-col-task-name",
  "name": "原子：任务管理-任务表格'任务名称'列名验证",
  "description": "验证任务表格包含'任务名称'列，列名文案正确",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const arrows = document.querySelectorAll('.ant-tree-switcher:not(.ant-tree-switcher-noop)'); arrows.forEach(a => a.click()); return 'expanded'; })()",
      "description": "展开树形"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const headers = Array.from(document.querySelectorAll('th')).map(th => th.textContent.trim()); const hasTaskName = headers.some(h => h.includes('任务名称')); return { headers, hasTaskName }; })()",
      "description": "验证任务名称列",
      "storeAs": "colTaskName"
    },
    {
      "type": "assertStore",
      "key": "colTaskName",
      "path": "hasTaskName",
      "equals": true
    },
    {
      "type": "screenshot",
      "label": "tm-col-task-name",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
