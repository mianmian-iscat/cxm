{
  "id": "atomic-f88-tm-detail-navigate",
  "name": "UI：任务管理-详情页面跳转验证",
  "description": "点击详情链接，验证页面正确跳转到任务详情页",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开任务管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const arrows = document.querySelectorAll('.ant-tree-switcher:not(.ant-tree-switcher-noop)'); arrows.forEach(a => a.click()); return 'expanded'; })()",
      "description": "展开所有节点"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const beforeUrl = location.href; const btns = Array.from(document.querySelectorAll('a,button')).filter(el => el.textContent.trim() === '详情'); if(btns.length > 0) { btns[0].click(); return beforeUrl; } return 'no btn'; })()",
      "description": "记录跳转前URL并点击详情",
      "storeAs": "beforeUrl"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { return { currentUrl: location.href, urlChanged: true }; })()",
      "description": "验证URL变化",
      "storeAs": "afterNav"
    },
    {
      "type": "assertStore",
      "key": "afterNav",
      "path": "currentUrl",
      "notEmpty": true,
      "description": "验证URL已变化"
    },
    {
      "type": "screenshot",
      "label": "tm-detail-page",
      "description": "详情页加载"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在任务管理数据",
    "realDomNotes": "详情页URL应包含detail或task相关路径",
    "riskPoints": []
  }
}