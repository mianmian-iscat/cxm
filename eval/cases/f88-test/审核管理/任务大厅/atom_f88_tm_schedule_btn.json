{
  "id": "atom-f88-tm-schedule-btn",
  "name": "原子：任务管理-查看任务排期按钮文案与可见性",
  "description": "验证右上角'查看任务排期'按钮文案正确且可见",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const btn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('查看任务排期')); return { found: !!btn, text: btn?.textContent?.trim(), visible: btn ? btn.getBoundingClientRect().width > 0 : false }; })()",
      "description": "验证排期按钮",
      "storeAs": "scheduleBtn"
    },
    {
      "type": "assertStore",
      "key": "scheduleBtn",
      "path": "found",
      "equals": true
    },
    {
      "type": "assertStore",
      "key": "scheduleBtn",
      "path": "visible",
      "equals": true,
      "description": "断言按钮可见"
    },
    {
      "type": "screenshot",
      "label": "tm-schedule-btn",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
