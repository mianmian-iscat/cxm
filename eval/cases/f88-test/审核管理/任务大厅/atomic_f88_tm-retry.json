{
  "id": "atomic-f88-tm-retry",
  "name": "UI：任务管理-重试失败任务验证",
  "description": "找到失败任务的重试按钮并验证",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开任务管理"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const btns = Array.from(document.querySelectorAll('a,button')).filter(el => el.textContent.trim().includes('重试')); return { count: btns.length, texts: btns.map(b => b.textContent.trim()) }; })()",
      "description": "查找重试按钮",
      "storeAs": "retryBtns"
    },
    {
      "type": "assertStore",
      "key": "retryBtns",
      "path": "found",
      "equals": true,
      "description": "验证 查找重试按钮 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核",
      "description": "验证页面已加载"
    },
    {
      "type": "screenshot",
      "label": "tm-retry",
      "description": "重试按钮截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在任务管理数据",
    "realDomNotes": "重试仅对失败任务可用",
    "riskPoints": []
  }
}