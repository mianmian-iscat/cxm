{
  "id": "atom-f88-tm-tab-test",
  "name": "原子：任务管理-策略平台-测试 Tab文案验证",
  "description": "验证'策略平台-测试'Tab文案正确",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const tabs = Array.from(document.querySelectorAll('.ant-tabs-tab')); const test = tabs.find(t => t.textContent.includes('测试')); return { found: !!test, text: test?.textContent?.trim() }; })()",
      "description": "验证测试Tab",
      "storeAs": "tabTest"
    },
    {
      "type": "assertStore",
      "key": "tabTest",
      "path": "found",
      "equals": true,
      "description": "验证 验证测试Tab 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "tabTest",
      "path": "found",
      "equals": true,
      "description": "断言测试Tab存在"
    },
    {
      "type": "screenshot",
      "label": "tm-tab-test",
      "description": "测试Tab"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "",
    "realDomNotes": "",
    "riskPoints": [
      "无数据时为空"
    ]
  }
}