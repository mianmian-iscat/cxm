{
  "id": "atomic-f88-tm-assign-modal-open",
  "name": "UI：任务管理-分配明细弹窗打开与标题验证",
  "description": "点击分配明细，验证弹窗正确打开且标题正确",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/task-management?sourceTab=other",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开任务管理"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const arrows = document.querySelectorAll('.ant-tree-switcher:not(.ant-tree-switcher-noop)'); arrows.forEach(a => a.click()); return 'expanded'; })()",
      "description": "展开所有节点"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "capture",
      "action": "start",
      "description": "分配明细弹窗"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const btns = Array.from(document.querySelectorAll('a,button')).filter(el => el.textContent.trim() === '分配明细'); if(btns.length > 0) { btns[0].click(); return 'clicked'; } return 'no btn'; })()",
      "description": "点击分配明细"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const modal = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); if(!modal) return { hasModal: false }; const title = modal.querySelector('.ant-modal-title')?.textContent?.trim(); const body = modal.querySelector('.ant-modal-body')?.textContent?.trim()?.substring(0,200); return { hasModal: true, title, bodyLen: body?.length || 0 }; })()",
      "description": "验证弹窗标题",
      "storeAs": "modalInfo"
    },
    {
      "type": "assertStore",
      "key": "modalInfo",
      "path": "hasModal",
      "equals": true,
      "description": "验证弹窗已打开"
    },
    {
      "type": "assertStore",
      "key": "modalInfo",
      "path": "title",
      "notEmpty": true,
      "description": "验证弹窗标题非空"
    },
    {
      "type": "screenshot",
      "label": "tm-assign-modal",
      "description": "分配明细弹窗"
    },
    {
      "type": "capture",
      "action": "stop",
      "description": "停止抓包"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在任务管理数据",
    "realDomNotes": "弹窗标题应包含'分配明细'或任务名称",
    "riskPoints": []
  }
}