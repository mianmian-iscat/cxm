{
  "id": "normal-f88-image-action-download",
  "name": "正常流程：F88 图片审核-下载按钮触发",
  "description": "进入图片审核详情，hover素材图触发工具栏，点击下载按钮，验证触发下载行为（通过network capture或页面反馈）。",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开个人任务中心"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待任务列表"
    },
    {
      "type": "selectOption",
      "label": "审核状态",
      "option": "待审核",
      "description": "筛选待审核任务"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待筛选结果"
    },
    {
      "type": "clickText",
      "text": "审核",
      "description": "打开第一条待审核任务"
    },
    {
      "type": "wait",
      "ms": 2500,
      "description": "等待审核详情Drawer打开"
    },
    {
      "type": "hover",
      "selector": "img",
      "description": "hover素材图触发工具栏"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待工具栏出现"
    },
    {
      "type": "clickText",
      "text": "下载",
      "description": "点击下载按钮"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待下载触发"
    },
    {
      "type": "screenshot",
      "label": "f88-image-download-clicked",
      "description": "截图-下载按钮点击后"
    },
    {
      "type": "clickText",
      "text": "取消",
      "description": "关闭抽屉"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在待审核图片任务。",
    "realDomNotes": "下载按钮（向下箭头图标）触发图片下载。",
    "riskPoints": [
      "下载为浏览器行为，runner不校验文件落盘",
      "无待审核任务时无法进入详情"
    ]
  }
}