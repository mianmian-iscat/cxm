{
  "id": "atomic-f88-audit-reject-rebirth",
  "name": "UI：审核详情-驳回重生触发验证",
  "description": "验证封面图审核(qt=4)驳回后触发重生流程",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开个人任务中心"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "审核任务",
      "description": "切换到审核任务Tab"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待Tab切换"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const rows = document.querySelectorAll('tr[class*=row],[class*=task-item]'); if(rows.length > 0) { rows[0].click(); return 'clicked'; } return 'no task'; })()",
      "description": "点击第一条任务"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const hasRegen = t.includes('重生') || t.includes('reGen') || t.includes('regenerate'); return { hasRegen }; })()",
      "description": "检查重生相关标识",
      "storeAs": "regenInfo"
    },
    {
      "type": "screenshot",
      "label": "audit-reject-rebirth",
      "description": "驳回重生验证"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在待审核任务",
    "realDomNotes": "封面图审核(qt=4)驳回触发重生(reGen)",
    "riskPoints": []
  }
}