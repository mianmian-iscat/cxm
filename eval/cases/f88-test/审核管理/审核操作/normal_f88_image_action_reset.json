{
  "id": "normal-f88-image-action-reset",
  "name": "正常流程：F88 图片审核-复位按钮触发",
  "description": "进入图片审核详情，hover素材图触发工具栏，点击复位按钮，验证复位确认提示或图片复位行为。",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开个人任务中心"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待任务列表"
    },
    {
      "type": "selectOption",
      "label": "审核状态",
      "option": "待审核",
      "description": "筛选待审核任务"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待筛选结果"
    },
    {
      "type": "clickText",
      "text": "审核",
      "description": "打开第一条待审核任务"
    },
    {
      "type": "wait",
      "ms": 2500,
      "description": "等待审核详情Drawer打开"
    },
    {
      "type": "hover",
      "selector": "img",
      "description": "hover素材图触发工具栏"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待工具栏出现"
    },
    {
      "type": "clickText",
      "text": "复位",
      "description": "点击复位按钮"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待复位确认或生效"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "复位",
      "description": "验证复位相关UI反馈"
    },
    {
      "type": "screenshot",
      "label": "f88-image-reset-clicked",
      "description": "截图-复位按钮点击后"
    },
    {
      "type": "clickText",
      "text": "取消",
      "description": "关闭抽屉"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在待审核图片任务。",
    "realDomNotes": "复位按钮用于撤销当前编辑操作，恢复图片原状；可能触发确认弹窗。",
    "riskPoints": [
      "复位按钮文案可能带空格",
      "无待审核任务时无法进入详情"
    ]
  }
}