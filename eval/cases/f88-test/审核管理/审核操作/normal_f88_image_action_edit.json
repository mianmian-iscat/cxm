{
  "id": "normal-f88-image-action-edit",
  "name": "正常流程：F88 图片审核-局部修改按钮触发",
  "description": "进入图片审核详情，hover素材图触发工具栏，点击局部修改按钮（EditOutlined图标，aria-label=edit），验证局部修改弹窗打开。",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开个人任务中心"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待任务列表"
    },
    {
      "type": "selectOption",
      "label": "审核状态",
      "option": "待审核",
      "description": "筛选待审核任务"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待筛选结果"
    },
    {
      "type": "clickText",
      "text": "审核",
      "description": "打开第一条待审核任务"
    },
    {
      "type": "wait",
      "ms": 2500,
      "description": "等待审核详情Drawer打开"
    },
    {
      "type": "hover",
      "selector": "img",
      "description": "hover素材图触发工具栏"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待工具栏出现"
    },
    {
      "type": "clickByAriaLabel",
      "label": "edit",
      "description": "点击局部修改按钮（EditOutlined图标，aria-label=edit）"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待局部修改弹窗渲染"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "局部修改",
      "description": "验证局部修改弹窗标题"
    },
    {
      "type": "screenshot",
      "label": "f88-image-local-modify-modal",
      "description": "截图-局部修改弹窗"
    },
    {
      "type": "clickText",
      "text": "取消",
      "description": "取消局部修改"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在待审核图片任务。",
    "realDomNotes": "局部修改按钮为EditOutlined图标（aria-label=edit），位于工具栏actionItem中；点击后弹出局部修改弹窗（LocalModifyModal），需填写prompt后确定。",
    "riskPoints": [
      "无待审核任务时找不到审核入口",
      "局部修改按钮为图标按钮无文字，需用aria-label定位"
    ]
  }
}