{
  "id": "atomic-f88-audit-material-switch",
  "name": "UI：审核详情-多素材切换验证",
  "description": "在审核详情页切换不同素材查看",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开个人任务中心"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "审核任务",
      "description": "切换到审核任务Tab"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待Tab切换"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const rows = document.querySelectorAll('tr[class*=row],[class*=task-item]'); if(rows.length > 0) { rows[0].click(); return 'clicked'; } return 'no task'; })()",
      "description": "点击第一条任务"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const navBtns = Array.from(document.querySelectorAll('button,a,[class*=nav]')).filter(el => el.textContent.trim().includes('上一') || el.textContent.trim().includes('下一') || el.getAttribute('aria-label')?.includes('prev') || el.getAttribute('aria-label')?.includes('next')); return { count: navBtns.length }; })()",
      "description": "查找素材切换按钮",
      "storeAs": "navBtns"
    },
    {
      "type": "screenshot",
      "label": "audit-material-switch",
      "description": "素材切换"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在待审核任务",
    "realDomNotes": "",
    "riskPoints": []
  }
}