{
  "id": "heal-modal-confirm-button",
  "name": "自愈验证：Modal 确认按钮多文案兼容",
  "description": "验证当 Modal 确认按钮文案不是标准的「确定」时，自愈引擎能通过正则匹配找到按钮",
  "businessType": "f88_material",
  "scene": "f88-test",
  "priority": "P0",
  "category": "self_healing_validation",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
