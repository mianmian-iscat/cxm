{
  "id": "atomic-f88-audit-video-play",
  "name": "UI：审核详情-视频播放控制验证",
  "description": "验证视频审核详情页播放器控件",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/personal-task-center",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开个人任务中心"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "审核任务",
      "description": "切换到审核任务Tab"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待Tab切换"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const rows = document.querySelectorAll('tr[class*=row],[class*=task-item]'); if(rows.length > 0) { rows[0].click(); return 'clicked'; } return 'no task'; })()",
      "description": "点击第一条任务"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const video = document.querySelector('video'); const controls = document.querySelectorAll('[class*=player],[class*=video]'); return { hasVideo: !!video, playerCount: controls.length }; })()",
      "description": "查找视频播放器",
      "storeAs": "videoPlayer"
    },
    {
      "type": "screenshot",
      "label": "audit-video-play",
      "description": "视频播放器"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在待审核任务",
    "realDomNotes": "视频播放器: 播放/暂停/拖拽",
    "riskPoints": []
  }
}