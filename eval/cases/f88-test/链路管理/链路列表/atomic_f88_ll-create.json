{
  "id": "atomic-f88-ll-create",
  "name": "UI：链路列表-新建链路入口验证",
  "description": "点击新建链路按钮，验证跳转或弹窗",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkList",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkList",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路列表"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "新建链路",
      "description": "点击新建链路"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { return { url: location.href, hasModal: !!document.querySelector('.ant-modal:not(.ant-modal-hidden)'), hasForm: !!document.querySelector('form,[class*=form]') }; })()",
      "description": "验证新建链路入口",
      "storeAs": "createResult"
    },
    {
      "type": "screenshot",
      "label": "ll-create",
      "description": "新建链路"
    },
    {
      "type": "evaluate",
      "expression": "(() => { if(location.href.includes('linkDetail')) return 'navigated'; if(document.querySelector('.ant-modal:not(.ant-modal-hidden)')) return 'modal'; return 'unknown'; })()",
      "description": "判断入口类型",
      "storeAs": "entryType"
    },
    {
      "type": "assertStore",
      "key": "entryType",
      "notEmpty": true,
      "description": "验证新建链路有响应"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在链路数据",
    "realDomNotes": "新建链路可能跳转详情页或弹窗",
    "riskPoints": []
  }
}