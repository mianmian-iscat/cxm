{
  "id": "atom-f88-ll-copy-btn",
  "name": "原子：链路列表-链路卡片'复制'按钮文案验证",
  "description": "验证链路卡片操作包含'复制'按钮",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkList",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkList",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const btns = Array.from(document.querySelectorAll('a, button')).filter(el => el.textContent.trim() === '复制'); return { found: btns.length > 0 }; })()",
      "description": "验证复制按钮",
      "storeAs": "llCopyBtns"
    },
    {
      "type": "assertStore",
      "key": "llCopyBtns",
      "path": "found",
      "equals": true,
      "description": "验证 验证复制按钮 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "链路",
      "description": "验证页面已加载"
    },
    {
      "type": "clickText",
      "text": "复制",
      "description": "点击复制按钮"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待操作响应"
    },
    {
      "type": "screenshot",
      "label": "after-click-llCopyBtns",
      "description": "点击复制后截图"
    },
    {
      "type": "screenshot",
      "label": "ll-copy-btn",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "",
    "realDomNotes": "",
    "riskPoints": [
      "无数据时为空"
    ]
  }
}