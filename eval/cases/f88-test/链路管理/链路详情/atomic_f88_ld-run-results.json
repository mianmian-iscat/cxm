{
  "id": "atomic-f88-ld-run-results",
  "name": "UI：链路详情-查看运行结果弹窗验证",
  "description": "点击查看运行结果按钮，验证弹窗展示5环节和任务列表",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "查看运行结果",
      "description": "点击查看运行结果"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const m = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); return { hasModal: !!m, title: m ? m.querySelector('.ant-modal-title')?.textContent?.trim() : null }; })()",
      "description": "验证弹窗",
      "storeAs": "resultModal"
    },
    {
      "type": "assertStore",
      "key": "resultModal",
      "path": "hasModal",
      "equals": true,
      "description": "验证运行结果弹窗出现"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const m = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); if(!m) return { stages: [] }; const text = m.textContent; const stages = ['刷标签','首图生图','首图审核','套图生图','套图审核']; const found = stages.filter(s => text.includes(s)); return { stages, found, coverage: found.length+'/'+stages.length }; })()",
      "description": "验证5环节",
      "storeAs": "stages"
    },
    {
      "type": "screenshot",
      "label": "ld-run-results",
      "description": "运行结果弹窗"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const c = document.querySelector('.ant-modal-close'); if(c) c.click(); return 'closed'; })()",
      "description": "关闭弹窗"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待加载"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；链路20180存在",
    "realDomNotes": "运行结果弹窗: 5环节(刷标签/首图生图/首图审核/套图生图/套图审核)/任务列表/状态/出参/终止/添加策略",
    "riskPoints": []
  }
}