{
  "id": "atomic-f88-ld-stages",
  "name": "UI：链路详情-链路阶段信息验证",
  "description": "验证链路阶段(实验/灰度)展示正确",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const t = document.body.innerText; const stages = ['实验','灰度','正式']; const found = stages.filter(s => t.includes(s)); return { stages, found }; })()",
      "description": "验证阶段信息",
      "storeAs": "stageInfo"
    },
    {
      "type": "assertStore",
      "key": "stageInfo",
      "path": "found",
      "equals": true,
      "description": "验证 验证阶段信息 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "链路",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "stageInfo",
      "path": "found",
      "notEmpty": true,
      "description": "验证阶段标签存在"
    },
    {
      "type": "screenshot",
      "label": "ld-stages",
      "description": "链路阶段信息"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；链路20180存在",
    "realDomNotes": "链路生命周期: 实验→灰度→正式",
    "riskPoints": []
  }
}