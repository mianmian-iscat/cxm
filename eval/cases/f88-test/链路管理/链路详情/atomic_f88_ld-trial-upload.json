{
  "id": "atomic-f88-ld-trial-upload",
  "name": "UI：链路详情-试运行上传Excel验证",
  "description": "在试运行弹窗中上传Excel文件",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "试运行",
      "description": "点击试运行"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const fileInput = document.querySelector('.ant-modal:not(.ant-modal-hidden) input[type=file]'); return { hasFileInput: !!fileInput, accept: fileInput ? fileInput.accept : null }; })()",
      "description": "查找文件上传控件",
      "storeAs": "fileInput"
    },
    {
      "type": "assertStore",
      "key": "fileInput",
      "path": "hasFileInput",
      "equals": true,
      "description": "验证文件上传控件存在"
    },
    {
      "type": "screenshot",
      "label": "ld-trial-upload",
      "description": "上传Excel控件"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const c = document.querySelector('.ant-modal-close'); if(c) c.click(); return 'closed'; })()",
      "description": "关闭弹窗"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待加载"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；链路20180存在",
    "realDomNotes": "上传Excel文件 input[type=file]",
    "riskPoints": []
  }
}