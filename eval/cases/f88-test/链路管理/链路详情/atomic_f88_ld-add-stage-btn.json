{
  "id": "atomic-f88-ld-add-stage-btn",
  "name": "UI：链路详情-添加环节按钮验证",
  "description": "验证链路详情页面底部存在添加环节按钮",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20243"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20243",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const addBtns = Array.from(document.querySelectorAll('button')).filter(b => b.textContent.includes('添加环节')); return { found: addBtns.length > 0, count: addBtns.length, texts: addBtns.map(b => b.textContent.trim()) }; })()",
      "description": "验证添加环节按钮",
      "storeAs": "addBtnInfo"
    },
    {
      "type": "assertStore",
      "key": "addBtnInfo",
      "path": "found",
      "equals": true,
      "description": "验证 验证添加环节按钮 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "链路",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "addBtnInfo",
      "path": "found",
      "equals": true,
      "description": "验证添加环节按钮存在"
    },
    {
      "type": "screenshot",
      "label": "ld-add-stage-btn",
      "description": "添加环节按钮"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在相关数据",
    "realDomNotes": "添加环节按钮在环节列表底部",
    "riskPoints": []
  }
}