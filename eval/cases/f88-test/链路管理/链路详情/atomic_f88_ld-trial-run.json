{
  "id": "atomic-f88-ld-trial-run",
  "name": "UI：链路详情-试运行弹窗验证",
  "description": "点击试运行按钮，验证弹窗出现及字段完整",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "试运行",
      "description": "点击试运行"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const m = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); return { hasModal: !!m, title: m ? m.querySelector('.ant-modal-title')?.textContent?.trim() : null }; })()",
      "description": "验证弹窗",
      "storeAs": "trialModal"
    },
    {
      "type": "assertStore",
      "key": "trialModal",
      "path": "hasModal",
      "equals": true,
      "description": "验证试运行弹窗出现"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const m = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); if(!m) return { fields: [] }; const inputs = Array.from(m.querySelectorAll('input,select,button')).map(i => ({ placeholder: i.placeholder || '', type: i.type, text: i.textContent?.trim()?.substring(0,30) || '', label: i.closest('.ant-form-item')?.querySelector('label')?.textContent?.trim() || '' })); return { fields: inputs }; })()",
      "description": "探查弹窗字段",
      "storeAs": "trialFields"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "下载模板",
      "description": "验证下载模板按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "任务名称",
      "description": "验证任务名称字段"
    },
    {
      "type": "screenshot",
      "label": "ld-trial-run",
      "description": "试运行弹窗"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const c = document.querySelector('.ant-modal-close'); if(c) c.click(); return 'closed'; })()",
      "description": "关闭弹窗"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待加载"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；链路20180存在",
    "realDomNotes": "试运行弹窗: 下载模板/上传Excel/任务名称/运行类型/发起任务运行",
    "riskPoints": []
  }
}