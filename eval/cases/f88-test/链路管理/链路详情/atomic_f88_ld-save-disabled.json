{
  "id": "atomic-f88-ld-save-disabled",
  "name": "UI：链路详情-保存按钮初始disabled验证",
  "description": "验证链路详情保存按钮初始状态为disabled，修改后启用",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20243"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20243",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const saveBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('保 存') || b.textContent.includes('保存')); if(!saveBtn) return { found: false }; return { found: true, disabled: saveBtn.disabled, text: saveBtn.textContent.trim() }; })()",
      "description": "验证保存按钮",
      "storeAs": "saveInfo"
    },
    {
      "type": "assertStore",
      "key": "saveInfo",
      "path": "found",
      "equals": true,
      "description": "验证保存按钮存在"
    },
    {
      "type": "assertStore",
      "key": "saveInfo",
      "path": "disabled",
      "equals": true,
      "description": "验证保存按钮初始disabled"
    },
    {
      "type": "screenshot",
      "label": "ld-save-btn",
      "description": "保存按钮状态"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在相关数据",
    "realDomNotes": "保存按钮初始disabled，修改链路配置后启用",
    "riskPoints": []
  }
}