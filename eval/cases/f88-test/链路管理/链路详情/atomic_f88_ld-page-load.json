{
  "id": "atomic-f88-ld-page-load",
  "name": "UI：链路详情-页面加载与链路名称验证",
  "description": "验证链路详情页加载，链路名称、阶段、环节展示正确",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const sections = ['链路阶段','环节列表','起点入参']; const found = sections.filter(s => t.includes(s)); return { sections, found, coverage: found.length+'/'+sections.length }; })()",
      "description": "验证关键区域",
      "storeAs": "sections"
    },
    {
      "type": "assertStore",
      "key": "sections",
      "path": "coverage",
      "notEmpty": true,
      "description": "验证关键区域存在"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const nameEl = document.querySelector('[class*=link-name],[class*=title]'); return { name: nameEl ? nameEl.textContent.trim() : null }; })()",
      "description": "获取链路名称",
      "storeAs": "linkName"
    },
    {
      "type": "screenshot",
      "label": "ld-page-load",
      "description": "链路详情页面"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；链路20180存在",
    "realDomNotes": "包含: 链路阶段(实验/灰度)、环节列表、起点入参",
    "riskPoints": []
  }
}