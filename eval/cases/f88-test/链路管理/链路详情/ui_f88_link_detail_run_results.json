{
  "id": "ui-f88-link-detail-run-results",
  "name": "UI：链路详情-查看运行结果弹窗验证",
  "description": "验证链路详情页查看运行结果按钮→弹窗/页面→运行结果数据展示",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P2",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "查看运行结果",
      "description": "点击查看运行结果"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const modal = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); const drawer = document.querySelector('.ant-drawer:not(.ant-drawer-hidden)'); const url = window.location.href; return { hasModal: !!modal, hasDrawer: !!drawer, urlChanged: url.includes('result') || url.includes('run') }; })()",
      "description": "验证运行结果展示形式",
      "storeAs": "runResult"
    },
    {
      "type": "screenshot",
      "label": "link-detail-run-results",
      "description": "运行结果"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；链路ID=20180存在且有运行记录。",
    "realDomNotes": "查看运行结果可能打开弹窗/Drawer或跳转页面，展示运行批次/状态/结果数据。",
    "riskPoints": [
      "无运行记录时可能为空"
    ]
  }
}