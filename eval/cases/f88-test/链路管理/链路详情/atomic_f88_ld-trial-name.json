{
  "id": "atomic-f88-ld-trial-name",
  "name": "UI：链路详情-试运行任务名称输入验证",
  "description": "在试运行弹窗中输入任务名称",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "clickText",
      "text": "试运行",
      "description": "点击试运行"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const m = document.querySelector('.ant-modal:not(.ant-modal-hidden)'); const input = m ? m.querySelector('input[placeholder*=任务名称]') : null; return { hasInput: !!input, placeholder: input ? input.placeholder : null }; })()",
      "description": "查找任务名称输入框",
      "storeAs": "nameInput"
    },
    {
      "type": "assertStore",
      "key": "nameInput",
      "path": "hasInput",
      "equals": true,
      "description": "验证任务名称输入框存在"
    },
    {
      "type": "screenshot",
      "label": "ld-trial-name",
      "description": "任务名称输入"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const c = document.querySelector('.ant-modal-close'); if(c) c.click(); return 'closed'; })()",
      "description": "关闭弹窗"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待加载"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；链路20180存在",
    "realDomNotes": "任务名称输入框 placeholder='请输入任务名称'",
    "riskPoints": []
  }
}