{
  "id": "atomic-f88-ld-steps",
  "name": "UI：链路详情-环节列表展示验证",
  "description": "验证环节列表包含所有配置的环节",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const steps = Array.from(document.querySelectorAll('[class*=step],[class*=stage],[class*=node]')).slice(0,10).map(el => el.textContent.trim().substring(0,60)); return { steps, count: steps.length }; })()",
      "description": "提取环节列表",
      "storeAs": "stepList"
    },
    {
      "type": "assertStore",
      "key": "stepList",
      "path": "found",
      "equals": true,
      "description": "验证 提取环节列表 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "链路",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "stepList",
      "path": "count",
      "notEmpty": true,
      "description": "验证环节列表非空"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const ths = Array.from(document.querySelectorAll('th, .ant-table-thead th')); return { columnCount: ths.length, headers: ths.slice(0, 15).map(th => (th.textContent || '').trim()) }; })()",
      "description": "检查表格列信息",
      "storeAs": "tableInfo"
    },
    {
      "type": "screenshot",
      "label": "ld-steps",
      "description": "环节列表"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；链路20180存在",
    "realDomNotes": "环节: 起点入参/刷标签/首图生图/首图审核/套图生图/套图审核",
    "riskPoints": []
  }
}