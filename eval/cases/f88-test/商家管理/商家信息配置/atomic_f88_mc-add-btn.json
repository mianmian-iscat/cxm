{
  "id": "atomic-f88-mc-add-btn",
  "name": "UI：商家管理-新增商家按钮验证",
  "description": "验证商家管理列表存在新增商家按钮",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/afdMerchantManagement/list"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/afdMerchantManagement/list",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开商家管理"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const addBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('新增商家')); return { found: !!addBtn, text: addBtn?.textContent?.trim() }; })()",
      "description": "验证新增商家按钮",
      "storeAs": "addBtnInfo"
    },
    {
      "type": "assertStore",
      "key": "addBtnInfo",
      "path": "found",
      "equals": true,
      "description": "验证 验证新增商家按钮 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "列表",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "addBtnInfo",
      "path": "found",
      "equals": true,
      "description": "验证新增商家按钮存在"
    },
    {
      "type": "clickText",
      "text": "新增",
      "description": "点击新增按钮"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待操作响应"
    },
    {
      "type": "screenshot",
      "label": "after-click-action",
      "description": "点击新增后截图"
    },
    {
      "type": "screenshot",
      "label": "mc-add-btn",
      "description": "新增商家按钮"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在相关数据",
    "realDomNotes": "",
    "riskPoints": []
  }
}