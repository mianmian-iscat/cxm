{
  "id": "atom-f88-mc-table-headers",
  "name": "原子：商家信息配置-表格列名完整性验证",
  "description": "验证表格包含店铺信息/合作供应商/参考竞店/负责买手/视觉偏好/搭配偏好/操作列",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/afdMerchantManagement/shopConfig",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/afdMerchantManagement/shopConfig",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开页面"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const headers = Array.from(document.querySelectorAll('th')).map(th => th.textContent.trim()); const required = ['店铺信息', '合作供应商', '参考竞店', '负责买手', '视觉偏好', '搭配偏好', '操作']; const found = required.filter(r => headers.some(h => h.includes(r))); return { headers, required, found, coverage: found.length + '/' + required.length }; })()",
      "description": "验证商家配置表格列名",
      "storeAs": "mcHeaders"
    },
    {
      "type": "assertStore",
      "key": "mcHeaders",
      "path": "found",
      "equals": true,
      "description": "验证 验证商家配置表格列名 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "商家",
      "description": "验证页面已加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const ths = Array.from(document.querySelectorAll('th, .ant-table-thead th')); return { columnCount: ths.length, headers: ths.slice(0, 15).map(th => (th.textContent || '').trim()) }; })()",
      "description": "检查表格列信息",
      "storeAs": "mcHeadersInfo"
    },
    {
      "type": "screenshot",
      "label": "mc-table-headers",
      "description": "截图"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "",
    "realDomNotes": "",
    "riskPoints": [
      "无数据时为空"
    ]
  }
}