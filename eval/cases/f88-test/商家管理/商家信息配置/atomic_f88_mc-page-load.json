{
  "id": "atomic-f88-mc-page-load",
  "name": "UI：商家信息配置-页面加载与文案完整性",
  "description": "验证页面标题、表格列名(店铺信息/合作供应商/参考竞店/负责买手/视觉偏好/搭配偏好/参考视觉图例/操作)",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/afdMerchantManagement/shopConfig",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/afdMerchantManagement/shopConfig",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开商家信息配置"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待加载"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const headers = Array.from(document.querySelectorAll('th')).map(th => th.textContent.trim()); return { headers, count: headers.length }; })()",
      "description": "获取表格列名",
      "storeAs": "headers"
    },
    {
      "type": "assertStore",
      "key": "headers",
      "path": "count",
      "notEmpty": true,
      "description": "验证列名非空"
    },
    {
      "type": "evaluate",
      "expression": "(() => { const t = document.body.innerText; const cols = ['店铺信息','合作供应商','参考竞店','负责买手','视觉偏好','搭配偏好','操作']; const found = cols.filter(c => t.includes(c)); return { cols, found, coverage: found.length+'/'+cols.length }; })()",
      "description": "验证列名文案",
      "storeAs": "colCheck"
    },
    {
      "type": "screenshot",
      "label": "mc-page-load",
      "description": "商家信息配置页面"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录；存在商家配置数据",
    "realDomNotes": "表格列: 店铺信息/合作供应商/参考竞店/负责买手/视觉偏好/搭配偏好/参考视觉图例/操作",
    "riskPoints": []
  }
}