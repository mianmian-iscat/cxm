{
  "id": "atomic-f88-mc-batch-download",
  "name": "UI：店铺信息配置-批量下载按钮验证",
  "description": "验证批量下载按钮存在且可点击",
  "businessType": "f88_material_audit",
  "scene": "f88-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/afdMerchantManagement/shopConfig",
    "waitAfterLoad": 3000,
    "auth": "buc",
    "captureFilter": "bzb.api.fsyx_quality_guard"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/afdMerchantManagement/shopConfig",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开店铺信息配置"
    },
    {
      "type": "wait",
      "ms": 6000,
      "description": "等待SPA加载完成"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { return { url: window.location.href, bodyLen: (document.body?.innerText || '').length }; })()",
      "description": "验证页面已稳定加载"
    },
    {
      "type": "evaluate",
      "expression": "return (() => { const btn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.trim() === '批量下载'); return { found: !!btn, disabled: btn?.disabled, text: btn?.textContent?.trim() }; })()",
      "description": "查找批量下载按钮",
      "storeAs": "dlBtn"
    },
    {
      "type": "assertStore",
      "key": "dlBtn",
      "path": "found",
      "equals": true,
      "description": "验证 查找批量下载按钮 存在"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "商家",
      "description": "验证页面已加载"
    },
    {
      "type": "assertStore",
      "key": "dlBtn",
      "path": "found",
      "equals": true,
      "description": "批量下载按钮存在"
    },
    {
      "type": "clickText",
      "text": "下载",
      "description": "点击下载按钮"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待操作响应"
    },
    {
      "type": "screenshot",
      "label": "after-click-action",
      "description": "点击下载后截图"
    },
    {
      "type": "screenshot",
      "label": "mc-batch-download",
      "description": "批量下载按钮"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "F88预发已登录",
    "realDomNotes": "批量下载为异步任务",
    "riskPoints": []
  }
}