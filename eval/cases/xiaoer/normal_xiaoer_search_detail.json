{
  "id": "normal-xiaoer-search-detail",
  "name": "正常流程：品质联盟商品搜索 → 结果验证 → 分页",
  "description": "验证品质联盟商品搜索完整链路：输入商品ID → 搜索 → 验证结果 → 翻页",
  "businessType": "product_management",
  "scene": "xiaoer",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "xiaoer.alibaba-inc.com",
    "url": "https://pre-xiaoer.alibaba-inc.com/bzb/fsyx_quality_guard/cobweb/skcList",
    "waitAfterLoad": 3000
  },
  "contextOptimization": null,
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-xiaoer.alibaba-inc.com/bzb/fsyx_quality_guard/cobweb/skcList",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开商品列表页"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待列表初始加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "SKC",
      "description": "验证商品列表页已渲染"
    },
    {
      "type": "fill",
      "selector": "input[placeholder='多个ID以英文逗号分隔']",
      "selectorIndex": 1,
      "value": "1046387089006",
      "description": "输入平台商品ID"
    },
    {
      "type": "clickText",
      "text": "搜索",
      "selector": "button.ant-btn-primary",
      "description": "点击搜索"
    },
    {
      "type": "waitForAPI",
      "urlPattern": "countSkcItemV2",
      "timeout": 10000,
      "description": "等待搜索API响应"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待结果渲染"
    },
    {
      "type": "screenshot",
      "label": "search-result",
      "description": "截图 - 搜索结果"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "总共",
      "description": "验证搜索有结果"
    },
    {
      "type": "assert",
      "target": "api",
      "urlPattern": "countSkcItemV2",
      "contains": "skcCount",
      "description": "【接口契约】验证响应包含 skcCount 字段"
    }
  ],
  "capture": {
    "enabled": true,
    "filter": "/cobweb/api/",
    "captureBody": true
  },
  "screenshot": {
    "onError": true
  },
  "post_asserts": null,
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "品质联盟预发环境可访问，已登录，测试商品ID存在",
    "riskPoints": [
      "搜索结果为空时的提示",
      "API响应结构变更"
    ],
    "relatedDocs": [
      "scenes/product-management-test/references/page-structure.md"
    ]
  },
  "source": null,
  "sourceIds": null
}