  "_testDesign": {
    "preconditions": "测试小二BUC登录态有效，原创保护运营端列表页可访问且至少有一行数据",
    "riskPoints": [
      "「查看维权记录」入口可能为弹窗/抽屉/新页，断言用宽泛弹层选择器",
      "无数据行时无「查看维权记录」入口"
    ],
    "erratum": "原用例假设的独立路由 quality-pulse/tort-protection 未注册于本站点；维权功能实际聚合在运营端 taotian-apparel-original-protection-xiaoer/list 的行级「查看维权记录」，据真实页面重新定位",
    "qoderworkRef": "test_08_tort.py TC_TORT_006"
  }
