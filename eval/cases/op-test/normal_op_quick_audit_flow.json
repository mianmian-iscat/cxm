{
  "id": "normal-op-quick-audit-flow",
  "name": "正常流程：原创保护快审节点全链路",
  "description": "验证PRD'增加快审节点'核心流程——小二端打开快审Drawer、提交快审、状态流转为QUICK_AUDITING",
  "businessType": "original_protection",
  "scene": "op-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-xiaoer.alibaba-inc.com",
    "url": "https://pre-xiaoer.alibaba-inc.com/bzb/noone/taotian-apparel-original-protection-xiaoer/list",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "contextOptimization": null,
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-xiaoer.alibaba-inc.com/bzb/noone/taotian-apparel-original-protection-xiaoer/list",
      "description": "打开原创保护小二端列表页"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待页面加载完成"
    },
    {
      "type": "screenshot",
      "name": "op-list-page-loaded",
      "description": "列表页截图确认加载成功"
    },
    {
      "type": "assert",
      "assertion": "pageContainsText",
      "text": "申请状态",
      "description": "确认列表页含申请状态筛选字段"
    },
    {
      "type": "clickText",
      "text": "发起快审",
      "description": "点击行级「发起快审」按钮触发快审Drawer"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待Drawer动画与内容加载完成"
    },
    {
      "type": "screenshot",
      "name": "op-quick-audit-drawer-open",
      "description": "快审Drawer截图"
    },
    {
      "type": "assert",
      "assertion": "elementVisible",
      "selector": ".tbd-drawer, .ant-drawer",
      "description": "确认Drawer组件已展开（真实UI为TBD .tbd-drawer，勘误）"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "sellerid",
      "description": "【Drawer内容】验证含商家sellerId必填字段"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "产品图片",
      "description": "【Drawer内容】验证含产品图片上传区"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "主视图",
      "description": "【Drawer内容】验证含主视图预览"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "提交",
      "description": "【Drawer操作】验证含提交按钮"
    }
  ],
  "capture": {
    "enabled": true,
    "filter": "taobao.industry.yc",
    "captureBody": true
  },
  "screenshot": {
    "onError": true,
    "onStep": [
      "op-list-page-loaded",
      "op-quick-audit-drawer-open"
    ]
  },
  "post_asserts": null,
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "小二端BUC登录态有效，原创保护列表页可访问",
    "riskPoints": [
      "BUC登录态过期导致跳转",
      "快审按钮DOM存在但不可见",
      "Drawer弹出延迟导致断言超时"
    ],
    "relatedDocs": [
      "scenes/op-test/references/前端组件测试要点.md",
      "references/popup-handling.md"
    ],
    "expectedHealBehavior": "若Drawer未弹出，自愈引擎查询error-pattern-map中modal_not_appear规则自动重试",
    "verifyFields": [
      "output.steps[6].status == 'pass'",
      "output.steps[7].status == 'pass'"
    ],
    "prdSource": "原创保护-增加快审节点(2026.07.02)"
  },
  "source": null,
  "sourceIds": null
}