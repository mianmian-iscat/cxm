{
  "id": "normal-op-tort-inspection-detail",
  "name": "正常流程：原创保护运营端-维权记录弹层（InspectionDetail）结构验证",
  "description": "打开运营端列表页，点击一条记录的「查看维权记录」，验证InspectionDetail弹层渲染（URL解析入口/提交维权/巡检记录区域）。",
  "businessType": "xiaoer_original_protection",
  "scene": "op-test",
  "priority": "P1",
  "category": "normal_flow",
  "context": {
    "urlPattern": "pre-xiaoer.alibaba-inc.com",
    "url": "https://pre-xiaoer.alibaba-inc.com/bzb/noone/taotian-apparel-original-protection-xiaoer/list",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-xiaoer.alibaba-inc.com/bzb/noone/taotian-apparel-original-protection-xiaoer/list",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开运营端列表页"
    },
    { "type": "wait", "ms": 3000, "description": "等待列表数据加载" },
    { "type": "assert", "target": "page", "contains": "维权", "description": "验证维权入口存在" },
    {
      "type": "clickText",
      "text": "查看维权记录",
      "description": "点击第一条记录的查看维权记录"
    },
    { "type": "wait", "ms": 2000, "description": "等待维权记录弹层渲染" },
    { "type": "assert", "target": "page", "contains": "维权", "description": "验证维权弹层已打开" },
    { "type": "screenshot", "label": "op-tort-inspection-detail", "description": "截图-维权记录弹层" },
    { "type": "assert", "assertion": "tortConsistency", "expected": "运营端维权弹层概览统计 vs 维权记录列表一致", "description": "【数值一致性】校验维权弹层概览（疑似侵权共计等）与下方维权记录列表状态数量一致" },
    { "type": "clickText", "text": "取消", "description": "关闭弹层" }
  ],
  "screenshot": { "onError": true },
  "contextOptimization": { "screenshotExternal": true, "maxResponseSizeKb": 100, "outputCompact": true },
  "_expected": { "status": "pass" },
  "_testDesign": {
    "preconditions": "BUC已登录运营端；列表存在有维权数据的记录。",
    "realDomNotes": "维权功能聚合于运营端列表行级'查看维权记录'，打开维权记录弹层；功能：添加线索/URL解析/提交维权/巡检记录；饼图下架率。",
    "riskPoints": ["列表无维权数据时'查看维权记录'按钮不存在", "按钮文案需探查确认"]
  }
}
