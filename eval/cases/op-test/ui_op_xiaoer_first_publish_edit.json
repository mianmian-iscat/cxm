{
  "id": "ui-op-xiaoer-first-publish-edit",
  "name": "UI：原创保护小二端-首发标签内联编辑流程验证",
  "description": "验证小二端列表页「是否首发」列的内联编辑功能：点击编辑→弹出确认对话框→选择是/否→确认→验证值更新。同时检查T+3边界（首发3天内可编辑）和权限校验（非9类商家不可编辑）。",
  "businessType": "original_protection",
  "scene": "op-test",
  "priority": "P1",
  "category": "smoke",
  "context": {
    "urlPattern": "pre-xiaoer.alibaba-inc.com",
    "url": "https://pre-xiaoer.alibaba-inc.com/bzb/noone/taotian-apparel-original-protection-xiaoer/list",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-xiaoer.alibaba-inc.com/bzb/noone/taotian-apparel-original-protection-xiaoer/list",
      "waitUntil": "networkidle",
      "description": "打开小二端列表页"
    },
    {
      "type": "wait",
      "ms": 4000,
      "description": "等待列表加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "是否首发",
      "description": "验证含是否首发列"
    },
    {
      "type": "screenshot",
      "label": "xiaoer-first-publish-col",
      "description": "截图-是否首发列"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "确认",
      "description": "【内联编辑】验证含确认按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "累计维权次数",
      "description": "【佐证】验证为运营端列表页"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "BUC已登录小二端。",
    "realDomNotes": "是否首发列：内联下拉(是/否)+确认按钮。T+3内可编辑，T+4后只读。非9类商家不可编辑。",
    "riskPoints": [
      "非9类商家时首发列只读",
      "修改后需确认弹窗",
      "T+3/T+4边界需特定测试数据"
    ]
  }
}