{
  "id": "ui-op-data-consistency",
  "name": "UI：原创保护-全平台数据一致性专项校验（分页/维权/巡检/商品管理）",
  "description": "横向校验原创保护两端所有页面的数据一致性：1)小二端列表分页总数vs行数 2)商家端列表分页总数vs行数 3)运营端维权弹层概览vs列表 4)商家端维权详情概览vs列表 5)侵权巡检发现疑似侵权N例vs列表 6)商品管理总共N个SKC vs行数。暴露前端统计/渲染不一致bug。",
  "businessType": "original_protection",
  "scene": "op-test",
  "priority": "P1",
  "category": "regression",
  "context": {
    "urlPattern": "pre-xiaoer.alibaba-inc.com",
    "url": "https://pre-xiaoer.alibaba-inc.com/bzb/noone/taotian-apparel-original-protection-xiaoer/list",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-xiaoer.alibaba-inc.com/bzb/noone/taotian-apparel-original-protection-xiaoer/list",
      "waitUntil": "networkidle",
      "description": "打开小二端列表页"
    },
    {
      "type": "wait",
      "ms": 4000,
      "description": "等待列表加载"
    },
    {
      "type": "assert",
      "assertion": "paginationConsistency",
      "expected": "小二端列表分页总数 vs 行数一致",
      "description": "【一致性1-小二端列表】分页「共X条」vs 当前页行数"
    },
    {
      "type": "screenshot",
      "label": "consistency-xiaoer-list",
      "description": "截图-小二端列表分页"
    },
    {
      "type": "clickText",
      "text": "查看维权记录",
      "description": "打开维权记录弹层"
    },
    {
      "type": "wait",
      "ms": 2500,
      "description": "等待弹层加载"
    },
    {
      "type": "assert",
      "assertion": "tortConsistency",
      "expected": "维权弹层概览 vs 列表一致",
      "description": "【一致性2-维权弹层】概览统计 vs 列表状态数量"
    },
    {
      "type": "screenshot",
      "label": "consistency-tort-modal",
      "description": "截图-维权弹层"
    },
    {
      "type": "clickText",
      "text": "返",
      "description": "关闭维权弹层"
    },
    {
      "type": "wait",
      "ms": 1500,
      "description": "等待弹层关闭"
    },
    {
      "type": "navigate",
      "url": "https://pre-xiaoer.alibaba-inc.com/bzb/fsyx_quality_guard/quality-pulse/product-management?opGroupId=2.61036.61036.0.61036",
      "waitUntil": "networkidle",
      "description": "打开商品管理页"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待商品管理加载"
    },
    {
      "type": "assert",
      "assertion": "paginationConsistency",
      "expected": "商品管理分页总数 vs 行数一致",
      "description": "【一致性3-商品管理】「总共N个SKC」vs 当前页行数"
    },
    {
      "type": "screenshot",
      "label": "consistency-product-mgmt",
      "description": "截图-商品管理分页"
    }
  ],
  "screenshot": {
    "onError": true
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 100,
    "outputCompact": true
  },
  "_expected": {
    "status": "pass"
  },
  "_testDesign": {
    "preconditions": "BUC已登录小二端。",
    "realDomNotes": "数据一致性校验覆盖：1)小二端列表分页 2)维权弹层概览vs列表 3)商品管理SKC总数vs行数。已知问题：商品管理28行≠期望20行（真实页面BUG）。",
    "riskPoints": [
      "商品管理分页BUG（28行≠20行）可能导致FAIL",
      "维权弹层需有数据才能校验"
    ]
  }
}