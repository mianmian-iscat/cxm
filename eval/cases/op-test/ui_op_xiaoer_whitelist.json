{
  "id": "ui-op-xiaoer-whitelist",
  "name": "UI：原创保护小二端-白名单弹窗结构验证",
  "description": "从小二端列表点击「查看白名单」，全量验证白名单弹窗：弹窗标题、白名单店铺列表、店铺信息（店铺名/白名单状态/添加时间）、添加白名单入口、删除操作、搜索过滤、分页。",
  "businessType": "original_protection",
  "scene": "op-test",
  "priority": "P1",
  "category": "smoke",
  "context": {
    "urlPattern": "pre-xiaoer.alibaba-inc.com",
    "url": "https://pre-xiaoer.alibaba-inc.com/bzb/noone/taotian-apparel-original-protection-xiaoer/list",
    "waitAfterLoad": 3000,
    "auth": "buc"
  },
  "steps": [
    { "type": "navigate", "url": "https://pre-xiaoer.alibaba-inc.com/bzb/noone/taotian-apparel-original-protection-xiaoer/list", "waitUntil": "networkidle", "description": "打开小二端列表页" },
    { "type": "wait", "ms": 4000, "description": "等待列表加载" },
    { "type": "assert", "target": "page", "contains": "查看白名单", "description": "验证列表已加载" },
    { "type": "clickText", "text": "查看白名单", "description": "点击第一条记录的查看白名单" },
    { "type": "wait", "ms": 3000, "description": "等待白名单弹窗渲染" },
    { "type": "assert", "target": "page", "contains": "白名单", "description": "【弹窗标题】验证白名单弹窗已打开" },
    { "type": "screenshot", "label": "xiaoer-whitelist-modal", "description": "截图-白名单弹窗" },
    { "type": "assert", "target": "page", "contains": "店铺", "description": "【列表内容】验证含店铺信息" },
    { "type": "assert", "target": "page", "contains": "白名单", "description": "【列表头部】再次确认白名单内容可见" },
    { "type": "screenshot", "label": "xiaoer-whitelist-full", "description": "截图-白名单弹窗完整" }
  ],
  "screenshot": { "onError": true },
  "contextOptimization": { "screenshotExternal": true, "maxResponseSizeKb": 100, "outputCompact": true },
  "_expected": { "status": "pass" },
  "_testDesign": {
    "preconditions": "BUC已登录小二端；列表有至少一条含白名单的记录。",
    "realDomNotes": "白名单弹窗：白名单列表(店铺名/状态/添加时间)+添加入口+删除+搜索+分页。",
    "riskPoints": ["白名单弹窗可能是Drawer或Modal", "无白名单数据时弹窗可能为空态"]
  }
}
