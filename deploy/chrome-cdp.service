# chrome-cdp.service — Chrome CDP 常驻服务
#
# 安装方式：
#   sudo cp deploy/chrome-cdp.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now chrome-cdp
#
# 查看状态：
#   systemctl status chrome-cdp
#   journalctl -u chrome-cdp -f
#
# 注意：首次启动前需人工通过 VNC 登录一次 BUC/淘宝，之后登录态持久化在 user-data-dir

[Unit]
Description=Chrome CDP Service (port 9222)
After=network.target
Wants=xvfb.service

[Service]
Type=simple
User=automation
Environment=DISPLAY=:99
Environment=WEB_AUTO_CDP_URL=http://127.0.0.1:9222

# 等待 Xvfb 就绪
ExecStartPre=/bin/sleep 2

# 启动 Chrome（headful 模式，依赖 Xvfb 虚拟显示）
ExecStart=/usr/bin/google-chrome-stable \
  --remote-debugging-port=9222 \
  --remote-debugging-address=127.0.0.1 \
  --no-first-run \
  --no-default-browser-check \
  --disable-background-networking \
  --disable-sync \
  --disable-gpu \
  --disable-extensions \
  --disable-popup-blocking \
  --disable-translate \
  --metrics-recording-only \
  --safebrowsing-disable-auto-update \
  --window-size=1920,1080 \
  --user-data-dir=/data/chrome-profile \
  about:blank

# 崩溃自动重启
Restart=always
RestartSec=5

# 资源限制
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
