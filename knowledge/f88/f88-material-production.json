{
  "id": "f88-material-production",
  "description": "F88 素材生产 - 策略配置/批次管理/CRM/看板模块（F88策略平台）",
  "uiFramework": "react-antd",
  "captureFilter": "strategy|batch|material|crm",
  "lastUpdated": "2026-07-13",
  "initStatus": "enriched",
  "lastVerified": null,
  "verifiedByRun": null,

  "pageUrl": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/config",
  "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
  "urlRoute": "strategy/config",

  "notes": [
    "页面为 React + Ant Design 组件，策略编辑器使用DAG可视化画布",
    "策略节点通过data-node-type属性定位，如[data-node-type='gen_img']",
    "试运行按钮点击后可能耗时30-60秒（调用AI模型），需长超时",
    "批次管理列表有 F88_STREAM / F88_BATCH 两种类型",
    "CRM页面使用Ant Design ProTable，支持批量导出",
    "看板数据实时聚合，钉钉播报由diamond配置驱动"
  ],

  "pages": {
    "策略配置列表": {
      "route": "strategy/config",
      "description": "策略列表页，支持创建/编辑/复制/删除策略",
      "actions": ["创建策略", "编辑", "复制", "删除", "试运行"]
    },
    "策略编辑器": {
      "route": "strategy/editor/:id",
      "description": "DAG画布式策略编辑器，拖拽添加节点，连线配置流程",
      "nodeTypes": ["gen_img", "map_gen_img", "llm_text", "image_enhance", "auto_review", "template_embed"]
    },
    "批次管理": {
      "route": "batch/management",
      "description": "生产批次管理，支持按类型(F88_STREAM/F88_BATCH)筛选",
      "actions": ["查看", "终止", "重试"]
    },
    "素材写入": {
      "route": "material/write",
      "description": "手动/API方式写入素材到信息流",
      "validationRules": {
        "标题": "不超过20字",
        "文案": "10-1000字",
        "图片": "3-9张，比例3:4",
        "商品": "必须已上架，坑位未满"
      }
    },
    "CRM leads管理": {
      "route": "crm/leads",
      "description": "商家leads分配/跟进/筛选，含商家档案",
      "fields": ["商家地址(新增)", "跟进状态", "来源"],
      "removedFields": ["品类(已删除)", "价格带(已删除)"]
    },
    "看板": {
      "route": "dashboard",
      "description": "实时聚合看板，展示生产批次执行进度和数据统计"
    },
    "模板库": {
      "route": "template/library",
      "description": "素材模板管理，支持按类型/场景筛选"
    }
  },

  "workflowNodes": {
    "gen_img": {
      "description": "单张图片生成节点",
      "models": ["wan2.7-image", "wan2.7-image-pro", "gpt-image-2"],
      "params": {
        "ratio": ["1:1", "3:4"],
        "resolution": ["1K", "2K"],
        "model": "必选"
      },
      "trialRun": true,
      "note": "试运行验证单张生图质量"
    },
    "map_gen_img": {
      "description": "批量图片生成节点（多条记录并行）",
      "models": ["wan2.7-image", "wan2.7-image-pro"],
      "trialRun": true,
      "note": "每条记录独立生成"
    },
    "llm_text": {
      "description": "LLM文本生成节点",
      "models": ["claude-sonnet-4", "claude-sonnet-4-opus", "qwen3.6-plus"],
      "params": {
        "maxChars": "非必填，填写后严格限制输出字符数",
        "prompt": "必填"
      },
      "trialRun": true
    },
    "image_enhance": {
      "description": "图片高清化处理节点",
      "capabilities": ["分辨率提升", "质量改善"],
      "trialRun": true,
      "note": "输出高清化后的图片"
    },
    "auto_review": {
      "description": "AI机审节点",
      "algorithms": {
        "AI_QUALITY": "低质量AI识别 - aigcTag=false图片应PASS",
        "BAD_MATERIAL": "劣质素材识别 - npx/face_cover/messy/porno/stretch → REJECT",
        "CTR_RANKING": "CTR择优 - 多候选图按CTR预估分排序选出最优"
      },
      "trialRun": true
    }
  },

  "apis": {
    "策略试运行": {
      "name": "strategyTrial",
      "method": "POST",
      "urlKeyword": "strategy/trial",
      "timeout": 60000,
      "note": "调用AI模型可能耗时较长"
    },
    "提交素材任务": {
      "name": "submitMaterialTask",
      "method": "POST",
      "urlKeyword": "submitMaterialTask",
      "hsfService": "com.alibaba.f88.material.MaterialProductionService::submitMaterialTask",
      "note": "缺少必填字段时返回参数校验错误"
    },
    "查询批次列表": {
      "name": "queryBatchList",
      "method": "POST",
      "urlKeyword": "batch/list",
      "responseFields": ["batchId", "batchType", "status", "createTime"]
    },
    "查询批次详情": {
      "name": "queryBatchDetail",
      "method": "POST",
      "urlKeyword": "batch/detail",
      "responseFields": ["batchType", "records", "status"]
    },
    "追加批次记录": {
      "name": "appendRecordsToBatch",
      "method": "POST",
      "urlKeyword": "appendRecordsToBatch",
      "note": "追加后批次状态保持PROCESSING，支持单条/小批量"
    },
    "素材写入信息流": {
      "name": "writeMaterial",
      "method": "POST",
      "urlKeyword": "material/write",
      "validations": ["标题≤20字", "文案10-1000字", "图片3-9张3:4", "商品已上架", "坑位未满"],
      "note": "校验失败返回明确错误信息"
    },
    "模板嵌入推理": {
      "name": "templateInference",
      "method": "POST",
      "urlKeyword": "tppwork.taobao.com/pyinfer_tao_ea119/api/v1/inference/sync",
      "appId": 58550,
      "note": "图片URL必须使用https，不支持普通http"
    },
    "CPV平台品查询": {
      "name": "cpvQuery",
      "method": "POST",
      "urlKeyword": "app-mobd-30to.1d.alibaba-inc.com",
      "env": "PRE",
      "note": "通过平台品ID查询CPV属性值"
    }
  },

  "businessRules": {
    "流式生产": {
      "batchType": "F88_STREAM",
      "幂等规则": "每个linkId每天创建一个F88_STREAM批次",
      "状态流转": "INIT → PROCESSING → COMPLETED",
      "追加规则": "appendRecordsToBatch追加后状态保持PROCESSING"
    },
    "素材写入校验": {
      "标题": "不超过20字，超过返回校验错误",
      "文案": "10-1000字，不在范围内返回校验错误",
      "图片数量": "3-9张，不在范围内返回校验错误",
      "图片比例": "3:4",
      "商品状态": "必须已上架，未上架返回'商品未上架'错误",
      "坑位": "已满时返回'坑位已满'错误"
    },
    "CRM字段变更": {
      "新增": ["商家地址"],
      "删除": ["品类", "价格带"],
      "note": "leads列表字段已变更，需验证旧字段不再展示"
    },
    "看板播报": {
      "trigger": "diamond配置驱动",
      "channel": "钉钉群",
      "note": "实时聚合批次执行数据"
    },
    "视觉企划配置": {
      "operations": "CRUD(创建/读取/更新/删除)",
      "scope": "商家级别",
      "note": "配置驱动模板选择"
    }
  },

  "assertHints": {
    "试运行成功": {
      "target": "api",
      "urlPattern": "strategy/trial",
      "path": "data.success",
      "equals": true
    },
    "批次为STREAM类型": {
      "target": "api",
      "urlPattern": "batch/detail",
      "path": "data.data.batchType",
      "equals": "F88_STREAM"
    },
    "素材写入校验失败": {
      "target": "api",
      "urlPattern": "material/write",
      "path": "data.success",
      "equals": false
    }
  },

