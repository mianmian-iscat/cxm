  "knownIssues": [
    "策略编辑器为DAG画布，节点通过[data-node-type]属性定位",
    "试运行调用AI模型可能耗时30-60秒，超时设置需60000ms以上",
    "模板嵌入推理接口要求image_url为https链接",
    "CPV查询需指定env=PRE环境参数",
    "批次管理排序默认按创建时间倒序",
    "CRM导出功能需等待后台异步生成Excel",
    "季节标签/Caption等节点的imgUrl/taoCate需配置dataSourceConfig，否则save API返回B9999错误",
    "策略详情页assert target=page contains=节点名 会匹配策略名称导致假阳性，需用evaluate定位节点编排区",
    "链路详情页没有保存按钮，提交环节后自动保存",
    "按钮文本含空格（“保 存”），需用正则匹配"
  ],

  "hsfIntegration": {
    "mavenGroupId": "com.alibaba.f88",
    "services": [
      {
        "interface": "com.alibaba.f88.material.MaterialProductionService",
        "methods": ["submitMaterialTask", "appendRecordsToBatch", "writeMaterial"]
      }
    ]
  },

  "workflowPatterns": {
    "standardPipeline": "刷标签 → 首图生图 → 首图审核 → 套图生图 → 套图审核",
    "keyRules": [
      "生图之后必有人工审核",
      "LLM文本生成→模板匹配→生图 是经典三段式",
      "入参逐级传递: seller_id→seed_image_url→main_img_url→set_img_url",
      "上游出参=下游入参"
    ]
  },

  "templateMatchRules": {
    "processor": "TemplateMatchProcessor",
    "modes": {
      "规则匹配": {
        "handler": "TemplateMatchProcessor",
        "fields": ["seller_id", "排序维度", "硬匹配字段"],
        "sellerRequired": {"模板包": true, "模板库": false},
        "note": "基于规则过滤+排序，人工可精确控制"
      },
      "模型匹配": {
        "handler": "TemplateMatchProcessor + AI模型",
        "fields": ["模型选择"],
        "sellerRequired": false,
        "note": "由AI算法自动排序，不支持排序维度和硬匹配字段"
      }
    },
    "dataSources": ["模板包", "模板库"],
    "applyStages": ["搭配", "视觉", "套图"],
    "applyScenes": ["主图素材", "种草素材"],
    "knowledgeRefs": [
      "eval/cases/f88-test/模版库/模版匹配/MODEL_MATCH_RULES.md",
      "eval/cases/f88-test/模版库/模版匹配/CODE_LEVEL_MATCH_RULES.md",
      "eval/cases/f88-test/模版库/模版匹配/VALIDATION_RULES.md"
    ],
    "testCases": {
