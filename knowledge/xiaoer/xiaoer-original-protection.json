  "apis": {
    "商家签约": {
      "name": "sellerSign",
      "topApi": "taobao.industry.yc.seller.sign",
      "method": "POST",
      "hsfService": "SellerEnterToolService",
      "dbTable": "yc_seller_enter_info",
      "note": "签约幂等，重复签约不报错"
    },
    "权利申请": {
      "name": "rightApply",
      "topApi": "taobao.industry.yc.right.apply",
      "method": "POST",
      "hsfService": "RightApplyToolHsfService",
      "dbTable": "yc_right_apply"
    },
    "取消申请": {
      "name": "rightApplyCancel",
      "topApi": "taobao.industry.yc.right.apply.cancel",
      "method": "POST",
      "note": "申请中状态可取消"
    },
    "终止保护": {
      "name": "rightApplyTerminate",
      "topApi": "taobao.industry.yc.right.apply.terminate",
      "method": "POST",
      "note": "保护中状态可终止"
    },
    "查询申请详情": {
      "name": "rightApplyGet",
      "topApi": "taobao.industry.yc.right.apply.get",
      "method": "POST"
    },
    "查询类目列表": {
      "name": "rightCategoryList",
      "topApi": "taobao.industry.yc.right.category.list",
      "method": "POST"
    },
    "查询保护商品": {
      "name": "rightItemPage",
      "topApi": "taobao.industry.yc.right.item.page",
      "method": "POST"
    },
    "提交维权": {
      "name": "rightProtectSubmit",
      "topApi": "taobao.industry.yc.right.protect.submit",
      "method": "POST"
    },
    "添加侵权线索": {
      "name": "tortAdd",
      "topApi": "taobao.industry.yc.tort.add",
      "method": "POST",
      "supportedPlatforms": ["淘宝", "天猫", "抖音", "小红书", "拼多多", "京东"],
      "requiredFields": ["店铺名", "平台", "商品URL", "店铺链接"]
    },
    "巡检记录": {
      "name": "tortPage",
      "topApi": "taobao.industry.yc.tort.page",
      "method": "POST"
    },
    "URL解析": {
      "name": "parseItemInfoByUrl",
      "path": "/api/common/parseItemInfoByUrl",
      "method": "POST",
      "note": "自动解析商品URL获取商品信息"
    },
    "签约申请提交": {
      "name": "submitToRegular",
      "path": "/api/seller/apply/submitToRegular",
      "method": "POST"
    }
  },

  "hsfServices": {
    "RightSettleToolHsfService": {
      "description": "结算工具服务",
      "relatedTables": ["yc_right_settle_order", "service_trade_record", "refund_apply_order"]
    },
    "RightApplyToolHsfService": {
      "description": "权利申请工具服务",
      "relatedTables": ["yc_right_apply", "yc_right_apply_op_record", "yc_right"]
    },
    "RightToolHsfService": {
      "description": "权利管理工具服务",
      "relatedTables": ["yc_right", "yc_inspect_whitelist"]
    },
    "SellerEnterToolService": {
      "description": "商家入驻工具服务",
      "relatedTables": ["yc_seller_enter_info", "yc_seller_contract_info"]
    },
    "ServiceTradeToolService": {
      "description": "交易服务工具",
      "relatedTables": ["service_trade_record", "yc_service_trade_record"]
    }
  },

  "dbTables": {
