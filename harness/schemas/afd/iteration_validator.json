{
  "name": "afd_iteration_validator",
  "version": "1.0.0",
  "description": "AFD 迭代状态机校验工具：验证视觉迭代的状态转换合法性、Guard 条件和 Side Effects",
  "triggers": ["迭代状态", "状态机", "状态校验", "iteration"],
  "parameters": {
    "type": "object",
    "required": ["iteration_id", "expected_state"],
    "properties": {
      "iteration_id": {
        "type": "string",
        "description": "视觉迭代ID"
      },
      "expected_state": {
        "type": "string",
        "enum": [
          "DRAFT_BRIEF", "PENDING_BRIEF", "REJECTED_BRIEF",
          "IN_PRODUCTION", "IN_REVIEW", "PENDING_LEADER",
          "RETURNED_TO_BUYER", "RETURNED",
          "ARCHIVED", "CANCELLED"
        ],
        "description": "期望的当前状态（10态枚举）"
      },
      "validate_transitions": {
        "type": "boolean",
        "default": true,
        "description": "是否校验状态转换合法性"
      },
      "include_history": {
        "type": "boolean",
        "default": false,
        "description": "是否返回完整状态变更历史"
      },
      "check_side_effects": {
        "type": "boolean",
        "default": true,
        "description": "是否检查状态变更的 Side Effects（如基准包生成、名额释放等）"
      }
    }
  },
  "returns": {
    "type": "object",
    "properties": {
      "valid": { "type": "boolean", "description": "状态是否合法" },
      "current_state": { "type": "string", "description": "当前实际状态" },
      "transition_valid": { "type": "boolean", "description": "最近一次状态转换是否合法" },
      "history": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from_state": { "type": "string" },
            "to_state": { "type": "string" },
            "actor_role": { "type": "string" },
            "occurred_at": { "type": "string" }
          }
        },
        "description": "状态变更历史（include_history=true 时返回）"
      },
      "errors": {
        "type": "array",
        "items": { "type": "string" },
        "description": "校验错误信息列表"
      }
    }
  },
  "timeout_ms": 10000,
  "retry_policy": { "max_retries": 1, "backoff": "fixed" }
}
