{
  "id": "tc11-rework-reshoot",
  "name": "打回买手/补拍流程",
  "description": "Leader打回买手→买手重审→或Leader确认驳回→产运补拍",
  "priority": "P1",
  "category": "functional",
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/styleShopCollab/iteration/test-iter-id",
      "waitUntil": "networkidle"
    },
    {
      "type": "assert",
      "target": "state",
      "value": "PENDING_LEADER"
    },
    {
      "type": "click",
      "selector": "button:has-text('打回买手')",
      "description": "Leader打回买手"
    },
    {
      "type": "fill",
      "selector": "textarea[placeholder*='调整意见']",
      "value": "试拍图片整体色调偏暗，建议增加自然光线拍摄",
      "react": true
    },
    {
      "type": "click",
      "selector": ".ant-modal button:has-text('确定')"
    },
    {
      "type": "wait",
      "ms": 2000
    },
    {
      "type": "assert",
      "target": "state",
      "value": "RETURNED_TO_BUYER"
    },
    {
      "type": "screenshot",
      "description": "截图打回后状态"
    }
  ],
  "assertions": [
    {
      "type": "state_is",
      "value": "RETURNED_TO_BUYER"
    }
  ],
  "tags": [
    "afd",
    "functional",
    "rework"
  ],
  "businessType": "afd_collab",
  "scene": "afd-test",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/styleShopCollab/iteration/test-iter-id",
    "waitAfterLoad": 3000
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 50,
    "outputCompact": true,
    "verboseMode": "summary"
  }
}