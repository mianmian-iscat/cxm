{
  "id": "tc03-new-iteration",
  "name": "新增视觉迭代",
  "description": "在无进行中迭代的店铺创建新迭代",
  "priority": "P0",
  "category": "functional",
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/styleShopCollab/shopList",
      "waitUntil": "networkidle"
    },
    {
      "type": "click",
      "selector": "button:has-text('新增视觉')",
      "description": "点击新增视觉按钮"
    },
    {
      "type": "wait",
      "ms": 500
    },
    {
      "type": "fill",
      "selector": ".ant-modal input[placeholder*='迭代名称']",
      "value": "测试迭代",
      "react": true
    },
    {
      "type": "click",
      "selector": ".ant-modal button:has-text('确定')"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待迭代创建"
    },
    {
      "type": "screenshot",
      "description": "截图新迭代详情页"
    }
  ],
  "assertions": [
    {
      "type": "state_is",
      "value": "DRAFT_BRIEF"
    }
  ],
  "tags": [
    "afd",
    "functional",
    "iteration"
  ],
  "businessType": "afd_collab",
  "scene": "afd-test",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/styleShopCollab/shopList",
    "waitAfterLoad": 3000
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 50,
    "outputCompact": true,
    "verboseMode": "summary"
  }
}