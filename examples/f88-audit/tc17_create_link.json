{
  "id": "f88-strategy-tc17",
  "name": "TC17 - 新建链路：点击新建 → 填写链路信息 → 链路详情验证",
  "businessType": "f88_material",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkList",
    "waitAfterLoad": 3000
  },
  "relatedCases": ["RP-NL-01~08"],
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkList",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路列表页"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "【租户身份验证】页面必须包含F88标识"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待页面完全加载"
    },

    {
      "type": "clickText",
      "text": "新建链路",
      "selector": "button, span, a",
      "description": "点击'新建链路'按钮"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待链路编辑页加载"
    },
    {
      "type": "screenshot",
      "name": "tc17-new-link-page",
      "description": "截图：新建链路页面"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "返回列表",
      "description": "新建链路页包含'返回列表'按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "链路阶段",
      "description": "新建链路页包含'链路阶段'配置"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "链路起点入参",
      "description": "新建链路页包含'链路起点入参'区域"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "试运行",
      "description": "新建链路页包含'试运行'按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "查看运行结果",
      "description": "新建链路页包含'查看运行结果'按钮"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "seller_id",
      "description": "链路起点入参包含 seller_id"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "seed_image_url",
      "description": "链路起点入参包含 seed_image_url"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "tao_cate",
      "description": "链路起点入参包含 tao_cate"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "item_id",
      "description": "链路起点入参包含 item_id"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "添加环节",
      "description": "链路详情页包含'添加环节'按钮"
    },

    {
      "type": "clickText",
      "text": "返回列表",
      "selector": "button, span, a",
      "description": "点击'返回列表'回到链路列表"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待列表加载"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "新建链路",
      "description": "确认回到链路列表页"
    }
  ]
}
