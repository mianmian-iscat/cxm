{
  "id": "f88-strategy-tc14",
  "name": "TC14 - 策略列表页：导航 + 搜索 + 筛选 + 新建/打开/删除策略",
  "businessType": "f88_material",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
    "waitAfterLoad": 3000
  },
  "relatedCases": ["RP-ST-01~06"],
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开策略列表页"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "【租户身份验证】页面必须包含F88标识"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待页面完全加载"
    },
    {
      "type": "screenshot",
      "name": "tc14-strategy-list-loaded",
      "description": "截图：策略列表页加载完成"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "策略名称",
      "description": "表头包含'策略名称'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "策略阶段",
      "description": "表头包含'策略阶段'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "环节",
      "description": "表头包含'环节'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "创建时间",
      "description": "表头包含'创建时间'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "提交人",
      "description": "表头包含'提交人'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "新建策略",
      "description": "页面包含'新建策略'按钮"
    },

    {
      "type": "fill",
      "selector": "input[placeholder*='搜索策略名称']",
      "value": "首图",
      "react": true,
      "description": "搜索框输入'首图'"
    },
    {
      "type": "pressKey",
      "key": "Enter",
      "description": "按回车执行搜索"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待搜索结果"
    },
    {
      "type": "screenshot",
      "name": "tc14-search-result",
      "description": "截图：策略搜索结果"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "打开",
      "description": "操作列包含'打开'按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "删除",
      "description": "操作列包含'删除'按钮"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "请选择",
      "description": "策略阶段/环节筛选下拉框存在"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "实验",
      "description": "列表中包含'实验'策略阶段"
    },

    {
      "type": "clickText",
      "text": "打开",
      "selector": "button, a, span",
      "description": "点击第一条策略的'打开'按钮进入策略详情页"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待策略详情页加载"
    },
    {
      "type": "screenshot",
      "name": "tc14-strategy-detail",
      "description": "截图：策略详情页"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "返回列表",
      "description": "策略详情页包含'返回列表'按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "策略阶段",
      "description": "策略详情页包含'策略阶段'配置"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "环节",
      "description": "策略详情页包含'环节'配置"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "试运行",
      "description": "策略详情页包含'试运行'按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "查看运行结果",
      "description": "策略详情页包含'查看运行结果'按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "保存",
      "description": "策略详情页包含'保存'按钮"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "策略说明",
      "description": "策略详情页包含'策略说明'文本域"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "适配场景",
      "description": "策略详情页包含'适配场景/商家画像'文本域"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "节点编排",
      "description": "策略详情页包含'节点编排'区域"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "策略入参",
      "description": "节点编排包含'策略入参'Start节点"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "策略出参",
      "description": "节点编排包含'策略出参'End节点"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "新增节点",
      "description": "节点编排包含'新增节点'按钮"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "落库配置",
      "description": "策略详情页包含'落库配置'区域"
    }
  ]
}
