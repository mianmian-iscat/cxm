{
  "id": "f88-audit-tc03",
  "name": "TC03 - 审核节点管理页：导航切换 + 节点列表加载 + 新增节点 + 排序验证",
  "businessType": "f88_material",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
    "waitAfterLoad": 3000
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/node-management",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开 F88 运营平台"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "【租户身份验证】页面必须包含F88标识"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待页面渲染"
    },

    {
      "type": "clickText",
      "text": "审核管理",
      "selector": "[class*='menu'], [class*='nav'], li, span",
      "description": "点击左侧导航'审核管理'展开子菜单"
    },
    {
      "type": "wait",
      "ms": 500,
      "description": "等待子菜单展开"
    },
    {
      "type": "clickText",
      "text": "审核节点管理",
      "selector": "[class*='menu'], [class*='nav'], li, span, a",
      "description": "点击'审核节点管理'子菜单"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待审核节点管理页面加载"
    },
    {
      "type": "screenshot",
      "label": "node-list-initial",
      "description": "截图 - 审核节点列表初始状态"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "审核节点管理",
      "description": "验证页面标题"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "节点名称",
      "description": "验证节点列表包含'节点名称'列"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "节点类型",
      "description": "验证节点列表包含'节点类型'列"
    },

    {
      "type": "clickText",
      "text": "新增节点",
      "selector": "button, .ant-btn",
      "description": "点击新增节点按钮（如存在）"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待弹窗/表单出现"
    },
    {
      "type": "screenshot",
      "label": "node-create-form",
      "description": "截图 - 新增节点表单"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "节点名称",
      "description": "验证表单包含'节点名称'字段"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "负责人",
      "description": "验证表单包含'负责人'字段"
    },

    {
      "type": "clickText",
      "text": "取消",
      "selector": "button, .ant-modal-footer button",
      "description": "取消新增"
    },
    {
      "type": "wait",
      "ms": 500,
      "description": "等待弹窗关闭"
    },

    {
      "type": "screenshot",
      "label": "node-list-final",
      "description": "截图 - 审核节点管理页最终状态"
    }
  ],
  "screenshot": {
    "onError": true,
    "onEachStep": false
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 50,
    "outputCompact": true,
    "verboseMode": "summary"
  }
}
