{
  "id": "f88-strategy-tc18",
  "name": "TC18 - 查看运行结果：弹窗 + 执行任务列表 + 环节阶段 + 状态/出参",
  "businessType": "f88_material",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000
  },
  "relatedCases": ["RP-RR-01~10"],
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "description": "打开链路详情页"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "【租户身份验证】页面必须包含F88标识"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待页面完全加载"
    },

    {
      "type": "clickText",
      "text": "查看运行结果",
      "selector": "button, span, a",
      "description": "点击'查看运行结果'按钮打开弹窗"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待运行结果弹窗加载"
    },
    {
      "type": "screenshot",
      "name": "tc18-run-results-modal",
      "description": "截图：查看运行结果弹窗"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "查看运行结果",
      "description": "弹窗标题或页面包含'查看运行结果'"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "刷标签",
      "description": "运行结果包含'刷标签'环节"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "首图生图",
      "description": "运行结果包含'首图生图'环节"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "首图审核",
      "description": "运行结果包含'首图审核'环节"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "套图生图",
      "description": "运行结果包含'套图生图'环节"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "套图审核",
      "description": "运行结果包含'套图审核'环节"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "进行中",
      "description": "任务状态包含'进行中'"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "seller_id",
      "description": "出参包含 seller_id"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "seed_image_url",
      "description": "出参包含 seed_image_url"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "industry_tag",
      "description": "出参包含 industry_tag"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "添加策略",
      "description": "环节内包含'添加策略'按钮"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "终止",
      "description": "任务操作包含'终止'按钮"
    }
  ]
}
