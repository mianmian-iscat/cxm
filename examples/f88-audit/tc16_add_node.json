{
  "id": "f88-strategy-tc16",
  "name": "TC16 - 新增节点：点击新增 → 选择节点类型弹窗 → 节点编排验证",
  "businessType": "f88_material",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
    "waitAfterLoad": 3000
  },
  "relatedCases": ["RP-ND-01~12"],
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/list",
      "waitUntil": "networkidle",
      "description": "打开策略列表页"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待页面加载"
    },
    {
      "type": "clickText",
      "text": "打开",
      "selector": "button, a, span",
      "description": "打开第一条策略进入策略详情页"
    },
    {
      "type": "wait",
      "ms": 3000,
      "description": "等待策略详情页加载"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "节点编排",
      "description": "页面包含'节点编排'区域"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "新增节点",
      "description": "节点编排区域包含'新增节点'按钮"
    },

    {
      "type": "clickText",
      "text": "新增节点",
      "selector": "button, span, a",
      "description": "点击'新增节点'按钮打开节点类型选择弹窗"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待弹窗加载"
    },
    {
      "type": "screenshot",
      "name": "tc16-node-type-modal",
      "description": "截图：选择节点类型弹窗"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "选择节点类型",
      "description": "弹窗标题为'选择节点类型'"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "LLM文本生成",
      "description": "节点类型包含'LLM文本生成'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "生图",
      "description": "节点类型包含'生图'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "Map生图",
      "description": "节点类型包含'Map生图'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "季节标签",
      "description": "节点类型包含'季节标签'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "产业标签",
      "description": "节点类型包含'产业标签'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "定价节点",
      "description": "节点类型包含'定价节点'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "模板匹配",
      "description": "节点类型包含'模板匹配'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "人工审核",
      "description": "节点类型包含'人工审核'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "推送选款",
      "description": "节点类型包含'推送选款'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "面料上身",
      "description": "节点类型包含'面料上身'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "款式分配",
      "description": "节点类型包含'款式分配'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "匹配度打分",
      "description": "节点类型包含'匹配度打分'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "图像裁头",
      "description": "节点类型包含'图像裁头'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "改款prompt推理",
      "description": "节点类型包含'改款prompt推理'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "Caption",
      "description": "节点类型包含'Caption'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "机审",
      "description": "节点类型包含'机审'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "视频生成",
      "description": "节点类型包含'视频生成'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "视频上传",
      "description": "节点类型包含'视频上传'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "高清化处理",
      "description": "节点类型包含'高清化处理'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "选片",
      "description": "节点类型包含'选片'"
    },

    {
      "type": "evaluate",
      "script": "(() => { const closeBtn = document.querySelector('.ant-modal-close, .ant-drawer-close, [class*=\"close\"]'); if (closeBtn) { closeBtn.click(); return true; } return false; })()",
      "description": "关闭节点类型选择弹窗"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待弹窗关闭"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "策略入参",
      "description": "节点编排-Start节点为'策略入参'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "策略出参",
      "description": "节点编排-End节点为'策略出参'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "Start",
      "description": "Start标签可见"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "End",
      "description": "End标签可见"
    }
  ]
}
