{
  "id": "f88-strategy-tc19",
  "name": "TC19 - 试运行弹窗：下载模板 + 上传Excel + 任务名称 + 运行类型 + 发起运行",
  "businessType": "f88_material",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000
  },
  "relatedCases": ["RP-TR-01~08"],
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "description": "打开链路详情页"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "【租户身份验证】页面必须包含F88标识"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待页面完全加载"
    },

    {
      "type": "clickText",
      "text": "试运行",
      "selector": "button.ant-btn-primary, button, span",
      "description": "点击'试运行'按钮打开弹窗"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待试运行弹窗加载"
    },
    {
      "type": "screenshot",
      "name": "tc19-trial-run-modal",
      "description": "截图：试运行弹窗"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "链路运行",
      "description": "弹窗标题为'链路运行'"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "下载模板",
      "description": "弹窗包含'下载模板'按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "上传Excel",
      "description": "弹窗包含'上传Excel'区域"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "任务名称",
      "description": "弹窗包含'任务名称'输入框"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "请输入任务名称",
      "description": "任务名称输入框占位符正确"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "运行类型",
      "description": "弹窗包含'运行类型'下拉选择"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "请选择运行类型",
      "description": "运行类型下拉框占位符正确"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "测试运行时审核任务会分给运行人",
      "description": "运行类型包含说明文字"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "正式",
      "description": "运行类型下拉选项包含'正式'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "测试",
      "description": "运行类型下拉选项包含'测试'"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "发起任务运行",
      "description": "弹窗包含'发起任务运行'按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "请先上传Excel文件",
      "description": "发起按钮提示'请先上传Excel文件'"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "查看运行结果",
      "description": "弹窗底部提示'查看运行结果'"
    }
  ]
}
