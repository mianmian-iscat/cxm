{
  "id": "f88-strategy-tc13",
  "name": "TC13 - 链路详情页：链路配置 + 环节展示 + 试运行 + 链路起点入参",
  "businessType": "f88_material",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
    "waitAfterLoad": 3000
  },
  "relatedCases": ["RP-LD-01~08"],
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/linkDetail?id=20180",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开链路详情页（【zy测试】主图生成链路 id=20180）"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "【租户身份验证】页面必须包含F88标识"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待页面完全加载"
    },
    {
      "type": "screenshot",
      "name": "tc13-link-detail-loaded",
      "description": "截图：链路详情页加载完成"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "zy测试",
      "description": "页面包含链路名称'zy测试'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "主图生成链路",
      "description": "页面包含链路完整名称"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "返回列表",
      "description": "页面包含'返回列表'按钮"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "链路阶段",
      "description": "页面包含'链路阶段'配置项"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "实验",
      "description": "链路阶段当前值为'实验'"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "试运行",
      "description": "页面包含'试运行'按钮"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "查看运行结果",
      "description": "页面包含'查看运行结果'按钮"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "链路起点入参",
      "description": "页面包含'链路起点入参'区域"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "seller_id",
      "description": "链路起点入参包含 seller_id"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "seed_image_url",
      "description": "链路起点入参包含 seed_image_url"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "tao_cate",
      "description": "链路起点入参包含 tao_cate"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "item_id",
      "description": "链路起点入参包含 item_id"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "刷标签",
      "description": "链路环节包含'刷标签'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "首图生图",
      "description": "链路环节包含'首图生图'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "首图审核",
      "description": "链路环节包含'首图审核'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "套图生图",
      "description": "链路环节包含'套图生图'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "套图审核",
      "description": "链路环节包含'套图审核'"
    }
  ]
}
