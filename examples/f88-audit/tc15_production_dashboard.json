{
  "id": "f88-strategy-tc15",
  "name": "TC15 - 生产看板页：整体推送进度 + 链路生产进度 + 任务展开/下载",
  "businessType": "f88_material",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
    "waitAfterLoad": 3000
  },
  "relatedCases": ["RP-PD-01~12"],
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/strategy/productionDashboard",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开生产看板页"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "【租户身份验证】页面必须包含F88标识"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待页面完全加载"
    },
    {
      "type": "screenshot",
      "name": "tc15-production-dashboard-loaded",
      "description": "截图：生产看板页加载完成"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "整体推送进度",
      "description": "页面包含'整体推送进度'区域标题"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "总任务数",
      "description": "整体推送进度包含'总任务数'统计卡片"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "生产中",
      "description": "整体推送进度包含'生产中'统计卡片"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "已推送",
      "description": "整体推送进度包含'已推送'统计卡片"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "未推送",
      "description": "整体推送进度包含'未推送'统计卡片"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "链路生产进度",
      "description": "页面包含'链路生产进度'区域标题"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "F88素材生成",
      "description": "链路生产进度中包含'F88素材生成'任务批次"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "展开",
      "description": "任务条目包含'展开'按钮（可查看详细节点信息）"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "下载",
      "description": "任务条目包含'下载'按钮"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "进行中",
      "description": "任务状态标签包含'进行中'"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "已通过",
      "description": "任务状态标签包含'已通过'"
    },

    {
      "type": "evaluate",
      "script": "(() => { const btn = [...document.querySelectorAll('button, span')].find(b => b.textContent.trim() === '展开'); if (btn) { btn.click(); return true; } return false; })()",
      "description": "点击第一个任务的'展开'按钮查看详情"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待展开内容加载"
    },
    {
      "type": "screenshot",
      "name": "tc15-task-expanded",
      "description": "截图：任务展开后的详细视图"
    }
  ]
}
