{
  "id": "f88-audit-tc02",
  "name": "TC02 - 审核标准管理页：导航切换 + 标准列表加载 + 新增/编辑/删除标准",
  "businessType": "f88_material",
  "context": {
    "urlPattern": "pre-aifashion-xiaoer.alibaba-inc.com",
    "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/standard-management",
    "waitAfterLoad": 3000
  },
  "steps": [
    {
      "type": "navigate",
      "url": "https://pre-aifashion-xiaoer.alibaba-inc.com/review/standard-management",
      "waitUntil": "networkidle",
      "screenshot": true,
      "description": "打开 F88 运营平台"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "F88",
      "description": "【租户身份验证】页面必须包含F88标识"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待页面渲染"
    },

    {
      "type": "clickText",
      "text": "审核管理",
      "selector": "[class*='menu'], [class*='nav'], li, span",
      "description": "点击左侧导航'审核管理'展开子菜单"
    },
    {
      "type": "wait",
      "ms": 500,
      "description": "等待子菜单展开"
    },
    {
      "type": "clickText",
      "text": "审核标准管理",
      "selector": "[class*='menu'], [class*='nav'], li, span, a",
      "description": "点击'审核标准管理'子菜单"
    },
    {
      "type": "wait",
      "ms": 2000,
      "description": "等待审核标准管理页面加载"
    },
    {
      "type": "screenshot",
      "label": "standard-list-initial",
      "description": "截图 - 审核标准列表初始状态"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "审核标准管理",
      "description": "验证页面标题"
    },

    {
      "type": "click",
      "selector": "[class*='menu'] >> text=审核标准管理",
      "description": "点击左侧导航'审核标准管理'（验证导航切换）"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待导航切换完成"
    },

    {
      "type": "screenshot",
      "label": "standard-list-table",
      "description": "截图 - 审核标准列表表格"
    },

    {
      "type": "clickText",
      "text": "新增标准",
      "selector": "button, .ant-btn",
      "description": "点击新增标准按钮（如存在）"
    },
    {
      "type": "wait",
      "ms": 1000,
      "description": "等待弹窗/表单出现"
    },
    {
      "type": "screenshot",
      "label": "standard-create-form",
      "description": "截图 - 新增标准表单"
    },

    {
      "type": "assert",
      "target": "page",
      "contains": "规则名称",
      "description": "验证表单包含'规则名称'字段"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "审核类型",
      "description": "验证表单包含'审核类型'字段"
    },

    {
      "type": "clickText",
      "text": "取消",
      "selector": "button, .ant-modal-footer button",
      "description": "取消新增（不实际提交）"
    },
    {
      "type": "wait",
      "ms": 500,
      "description": "等待弹窗关闭"
    },

    {
      "type": "screenshot",
      "label": "standard-list-final",
      "description": "截图 - 审核标准管理页最终状态"
    }
  ],
  "screenshot": {
    "onError": true,
    "onEachStep": false
  },
  "contextOptimization": {
    "screenshotExternal": true,
    "maxResponseSizeKb": 50,
    "outputCompact": true,
    "verboseMode": "summary"
  }
}
