    {
      "type": "waitForAPI",
      "urlPattern": "bzb.api.fsyx_quality_guard.f88.queryItemSuperDiscountActivity",
      "timeout": 15000,
      "description": "等待搜索接口响应"
    },
    {
      "type": "wait",
      "ms": 500,
      "description": "等待表格渲染"
    },
    {
      "type": "screenshot",
      "label": "search-result",
      "description": "截图 - 搜索结果"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "1044587480343",
      "description": "验证搜索结果包含目标商品ID"
    },
    {
      "type": "clickText",
      "text": "清退",
      "selector": "button, a, span",
