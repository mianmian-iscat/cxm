    {
      "type": "assert",
      "target": "api",
      "contains": "true",
      "description": "验证清退接口返回 success=true"
    },
    {
      "type": "assert",
      "target": "page",
      "contains": "已清退",
      "description": "验证页面显示已清退状态"
