  "editOperations": {
    "description": "所有编辑操作的通用测试参数",
    "commonFlow": {
      "step1": "执行编辑操作（替换/裁剪/高清化/局部修改）",
      "step2": "点击「编辑后」查看效果",
      "step3": "点击 ✅ 确认",
      "step4": "验证 toolbar 可见（CopyURL/下载按钮）",
      "step5": "验证 material.url 已更新，material.originUrl 不变"
    },
    "frontendLogic": "handleCopyUrl(img.originUrl || img.url)，originUrl 优先",
    "confirmMechanism": {
      "beforeConfirm": {
        "url": "原始URL",
        "localAdjustUrl": "编辑后URL",
        "localAdjustStatus": "≠0"
      },
      "afterConfirm": {
        "url": "编辑后URL（从localAdjustUrl写入）",
        "localAdjustUrl": "编辑后URL",
        "localAdjustStatus": "0"
      }
    },
    "toolbarVisibility": "编辑操作后必须经过「编辑后+✅确认」才显示toolbar，否则CopyURL/下载不可操作"
  },

  "downstreamVerification": {
    "description": "审核通过后的下游数据链路验证参数",
    "dataChain": "审核确认 → output_json(passedImg) → common_variable → 下游input_data",
    "dmsQueries": {
      "queryOutputJson": "SELECT output_json FROM workflow_record_log WHERE material_id = :materialId AND node_name = '人工审核' ORDER BY id DESC LIMIT 1",
      "queryCommonVariable": "SELECT common_variable FROM g_workflow_instance WHERE id IN (SELECT workflow_instance_id FROM workflow_record_log WHERE material_id = :materialId) LIMIT 1",
      "queryDownstreamInput": "SELECT input_data FROM workflow_record_log WHERE material_id = :materialId AND node_name IN ('算法过滤', '套图生产') ORDER BY id",
      "queryMaterialUrl": "SELECT url, origin_url FROM material WHERE id = :materialId"
    },
    "expectedResults": {
      "afterReplace": "下游所有节点的input_data中图片URL为替换后的新URL",
      "afterCrop": "下游所有节点的input_data中图片URL为裁剪后的新URL",
      "afterRegenerate": "下游所有节点的input_data中图片URL为重生后的新URL",
      "partialPass": "passedImg仅含通过图的URL，notPassImgUrl含被驳回图URL"
    }
  },

